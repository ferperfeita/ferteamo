def _normalized_snapshot_lines(text):
    """Normaliza texto genérico para comparaciones estables."""
    lines = set()
    for raw in safe_text(text).splitlines():
        line = re.sub(r"\s+", " ", raw.strip())
        if line:
            lines.add(line)
    return lines


def _normalize_logcat_line(raw):
    line = re.sub(r"\s+", " ", safe_text(raw).strip())
    if not line:
        return ""
    # Elimina fecha/epoch y PID/TID variables sin borrar tag ni mensaje.
    line = re.sub(r"^\d{10}(?:\.\d+)?\s+", "", line)
    line = re.sub(r"^\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\.\d+\s+", "", line)
    line = re.sub(r"^\d+\s+\d+\s+[VDIWEF]\s+", "", line)
    line = re.sub(r"\b0x[0-9a-fA-F]+\b", "0xHEX", line)
    line = re.sub(r"\b(pid|tid|uid)[=: ]+\d+\b", r"\1=N", line, flags=re.I)
    return line.lower()


def _logcat_snapshot(text):
    result = {}
    for raw in safe_text(text).splitlines():
        key = _normalize_logcat_line(raw)
        if key:
            result.setdefault(key, raw.strip())
    return result




def _logcat_epoch(raw):
    """Extrae epoch de una línea logcat -v epoch; devuelve None si no está disponible."""
    match = re.match(r"\s*([0-9]{9,}(?:\.[0-9]+)?)\s+", safe_text(raw))
    if not match:
        return None
    try:
        return float(match.group(1))
    except Exception:
        return None


def _humanize_logcat_event(raw):
    """Reduce ruido técnico sin ocultar la parte útil de una evidencia de logcat."""
    line = re.sub(r"\s+", " ", safe_text(raw).strip())
    # Quita epoch y columnas PID/TID/prioridad cuando están presentes.
    line = re.sub(r"^\d{9,}(?:\.\d+)?\s+", "", line)
    line = re.sub(r"^\d+\s+\d+\s+[VDIWEF]\s+", "", line)
    # Evita volcar rutas largas completas en localhost/reportes resumidos.
    line = re.sub(r"/(?:data|storage|sdcard|system|vendor|product|apex|mnt)/[^\s,;]+", "[ruta omitida]", line)
    return short_value(line, 360)


def scan_postmatch_logcat_evidence(rules, cutoff_time):
    """Analiza todos los buffers retenidos de logcat al iniciar el scanner y conserva solo posibles evidencias.

    Es deliberadamente post-partida: no pregunta hora de inicio. Usa la ventana interna existente y,
    cuando una línea no trae epoch fiable, la conserva solo si coincide con una señal fuerte.
    """
    status = {
        "available": False,
        "lines_checked": 0,
        "events_kept": 0,
        "categories": {},
        "events": [],
        "result": "NO_EJECUTADO",
    }
    if not adb_available() or not get_adb_connected_devices():
        return [], status

    status["available"] = True
    raw = adb_shell("logcat -b all -d -v epoch 2>/dev/null", timeout=75)
    lines = [line for line in safe_text(raw).splitlines() if line.strip()]
    status["lines_checked"] = len(lines)
    cutoff_epoch = cutoff_time.timestamp() if isinstance(cutoff_time, datetime) else None

    # Para el historial post-partida usamos señales fuertes de inyección; no mezclamos aquí
    # nombres de apps remotas ni términos genéricos de Free Fire para reducir falsos positivos.
    strong_terms = sorted(set(
        rules.get("hook_keywords", [])
        + rules.get("package_critical_indicators", [])
        + ["gameguardian", "game guardian", "androidgg", "memory patch", "ptrace",
           "frida-server", "gum-js-loop", "gdbserver", "lldb-server", "replay injector"]
    ))
    remote_terms = sorted(set(rules.get("remote_control_package_indicators", []) + ["scrcpy", "remote control", "screen share"]))

    # Señales contextuales que solo se guardan si son específicas; evitamos términos genéricos como "usb" aislado.
    category_patterns = [
        ("inyeccion_hooking", strong_terms),
        ("control_remoto", remote_terms),
        ("adb_usb", ["adb tcpip", "wireless debugging", "adb_auth", "adbkey", "adb_keys", "adbd_auth", "usbdevice.*adb", "sys.usb.config.*adb", "functionfs.*adb"]),
        ("ejecucion_temporal", ["/data/local/tmp", "gdbserver", "lldb-server", "app_process", "dalvikvm", "run-as", "ld_preload", "memfd"]),
        ("paquetes", ["package added", "package removed", "package replaced", "packageinstaller", "install_package", "uninstall_package", "delete_package"]),
        ("captura_acceso", ["mediaprojection", "accessibilityservice", "system_alert_window", "request_install_packages", "device admin", "device_policy"]),
    ]

    benign_terms = [safe_text(x).lower() for x in rules.get("benign_log_terms", [])]
    kept = []
    seen = set()
    for raw_line in lines:
        lower = raw_line.lower()
        epoch = _logcat_epoch(raw_line)
        # Para el análisis post-partida priorizamos la ventana interna; sin timestamp, exigimos señal fuerte.
        if cutoff_epoch is not None and epoch is not None and epoch < cutoff_epoch:
            continue

        category = None
        matched = []
        for cat, terms in category_patterns:
            local_hits = []
            for term in terms:
                term_l = safe_text(term).lower()
                if not term_l:
                    continue
                if ".*" in term_l:
                    try:
                        if re.search(term_l, lower):
                            local_hits.append(term)
                    except re.error:
                        pass
                elif term_l in lower:
                    local_hits.append(term)
            if local_hits:
                category = cat
                matched = local_hits
                break
        if not category:
            continue
        if any(term in lower for term in benign_terms) and category == "inyeccion_hooking":
            if not any(x in lower for x in ("frida", "xposed", "lsposed", "zygisk", "ptrace", "gdbserver", "lldb-server")):
                continue

        normalized = _normalize_logcat_line(raw_line)
        if normalized in seen:
            continue
        seen.add(normalized)
        stamp = _timeline_iso_from_epoch(epoch) if epoch is not None else None
        item = {
            "time": stamp,
            "category": category,
            "event": _humanize_logcat_event(raw_line),
            "matches": sorted(set(safe_text(x) for x in matched))[:8],
        }
        kept.append(item)
        status["categories"][category] = status["categories"].get(category, 0) + 1

    # Más recientes primero y límite razonable de salida; se analizaron todos los buffers retenidos.
    kept.sort(key=lambda x: safe_text(x.get("time")), reverse=True)
    status["events"] = kept[:160]
    status["events_kept"] = len(kept)
    status["result"] = "COMPLETADO"

    findings = []
    # Solo las categorías fuertes afectan el resumen de riesgo. El resto queda como evidencia contextual.
    for cat in ("inyeccion_hooking", "control_remoto", "ejecucion_temporal"):
        cat_events = [x for x in kept if x.get("category") == cat]
        if not cat_events:
            continue
        points = 18 if cat == "inyeccion_hooking" else 14 if cat == "control_remoto" else 12
        findings.append({
            "type": "logcat_history",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": "ALTA" if cat == "inyeccion_hooking" else "MEDIA",
            "evidence_level": "rastro_postpartida_logcat",
            "category": "logcat_postpartida",
            "indicator": f"postmatch_logcat_{cat}",
            "value": cat_events[:20],
            "reasons": ["Logcat retenido antes de iniciar el scanner conserva eventos potencialmente relevantes de la sesión reciente."],
            "source_group": "logcat_history",
        })
    return findings, status


def build_package_history(app_change_findings, special_access_status):
    """Crea un historial de paquetes legible para el resultado, sin rutas internas."""
    recent = []
    for item in app_change_findings:
        package = safe_text(item.get("package"))
        if not package:
            continue
        if item.get("recent_install") and item.get("recent_update"):
            action = "Instalada / actualizada recientemente"
        elif item.get("recent_install"):
            action = "Instalada recientemente"
        else:
            action = "Actualizada recientemente"
        recent.append({
            "package": package,
            "action": action,
            "time": item.get("first_install_time") if item.get("recent_install") else item.get("last_update_time"),
            "installer": item.get("installer") or "No visible",
            "risk": item.get("risk", "BAJO"),
        })
    recent.sort(key=lambda x: safe_text(x.get("time")), reverse=True)
    removed = [safe_text(x) for x in (special_access_status or {}).get("removed_suspicious_packages", []) if safe_text(x)]
    return {
        "recent_changes": recent[:50],
        "removed_suspicious": removed[:40],
        "recent_count": len(recent),
        "removed_suspicious_count": len(removed),
    }


def _normalize_process_identity(raw):
    line = re.sub(r"\s+", " ", safe_text(raw).strip())
    if not line or re.search(r"\bPID\b", line, re.I):
        return ""
    parts = line.split()
    # ps -A -o USER,PID,PPID,NAME,ARGS
    if len(parts) >= 5 and parts[1].isdigit() and parts[2].isdigit():
        name = parts[3]
        args = " ".join(parts[4:])
    else:
        # Fallback toybox: el nombre suele estar al final.
        name = parts[-1] if parts else ""
        args = name
    identity = f"{name} {args}".lower()
    identity = re.sub(r"\b0x[0-9a-f]+\b", "0xHEX", identity)
    identity = re.sub(r"\b\d{4,}\b", "N", identity)
    return re.sub(r"\s+", " ", identity).strip()


def _process_snapshot(text):
    result = {}
    for raw in safe_text(text).splitlines():
        key = _normalize_process_identity(raw)
        if key:
            result.setdefault(key, raw.strip())
    return result


def _android_uid_from_user(user):
    """Convierte usuarios toybox (u0_a123) a UID Android cuando es posible."""
    value = safe_text(user).strip()
    if value.isdigit():
        return int(value)
    match = re.fullmatch(r"u(\d+)_a(\d+)", value)
    if match:
        return (int(match.group(1)) * 100000) + 10000 + int(match.group(2))
    return None


def _process_records(text):
    records = {}
    for raw in safe_text(text).splitlines():
        line = re.sub(r"\s+", " ", raw.strip())
        if not line or re.search(r"\bPID\b", line, re.I):
            continue
        parts = line.split()
        if len(parts) >= 5 and parts[1].isdigit() and parts[2].isdigit():
            user, pid, ppid, name = parts[0], int(parts[1]), int(parts[2]), parts[3]
            args = " ".join(parts[4:])
        else:
            numeric = next((index for index, value in enumerate(parts[1:], 1) if value.isdigit()), None)
            if numeric is None:
                continue
            user, pid = parts[0], int(parts[numeric])
            ppid = int(parts[numeric + 1]) if len(parts) > numeric + 1 and parts[numeric + 1].isdigit() else None
            name = parts[-1]
            args = name
        records[pid] = {
            "pid": pid,
            "ppid": ppid,
            "user": user,
            "uid": _android_uid_from_user(user),
            "name": name,
            "args": args,
            "line": line[:500],
        }
    return records


def _parse_endpoint(value, port):
    address = safe_text(value).strip().strip("[]")
    if address.lower().startswith("::ffff:"):
        address = address[7:]
    try:
        port_value = int(port)
        if not 0 <= port_value <= 65535:
            port_value = None
    except Exception:
        port_value = None
    return address, port_value


def _parse_socket_record(raw):
    line = re.sub(r"\s+", " ", safe_text(raw).strip())
    if not line or line.lower().startswith(("netid ", "proto ", "active ")):
        return None
    lower = line.lower()
    proto_match = re.match(r"^(tcp6?|udp6?)\b", lower)
    proto = proto_match.group(1) if proto_match else "socket"
    state_match = re.search(
        r"\b(LISTEN|ESTAB|ESTABLISHED|CONNECTED|UNCONN|SYN-SENT|SYN-RECV|"
        r"TIME-WAIT|CLOSE-WAIT|LAST-ACK|FIN-WAIT-1|FIN-WAIT-2|CLOSED)\b",
        line.upper(),
    )
    state = state_match.group(1) if state_match else "CONNECTED"
    if state == "ESTABLISHED":
        state = "ESTAB"
    endpoint_matches = re.findall(
        r"(?<![A-Za-z0-9_.-])(\[[^\]]+\]|\*|[0-9A-Fa-f:.%]+):(\*|\d{1,5})(?!\d)",
        line,
    )
    endpoints = [_parse_endpoint(address, port) for address, port in endpoint_matches]
    local_address, local_port = endpoints[0] if endpoints else ("", None)
    remote_address, remote_port = endpoints[1] if len(endpoints) > 1 else ("", None)
    process_match = re.search(r'users:\(\("([^\"]+)', line)
    process = process_match.group(1) if process_match else ""
    pid_match = re.search(r"\bpid[=:](\d+)\b", lower)
    uid_match = re.search(r"\buid[=:](\d+)\b", lower)
    pid = int(pid_match.group(1)) if pid_match else None
    uid = int(uid_match.group(1)) if uid_match else None
    key = "|".join([
        proto,
        state,
        f"{local_address}:{local_port if local_port is not None else '*'}",
        f"{remote_address}:{remote_port if remote_port is not None else '*'}",
        str(uid or ""),
        process.lower(),
    ])
    return {
        "key": key,
        "line": line,
        "proto": proto,
        "state": state,
        "local_address": local_address,
        "local_port": local_port,
        "remote_address": remote_address,
        "remote_port": remote_port,
        "process": process,
        "pid": pid,
        "uid": uid,
    }


def _socket_snapshot(text):
    result = {}
    for raw in safe_text(text).splitlines():
        record = _parse_socket_record(raw)
        if record:
            result.setdefault(record["key"], record)
    return result


def _socket_is_public(line):
    lower = safe_text(line).lower()
    return any(token in lower for token in ["0.0.0.0:", "[::]:", ":::" ])


def _address_scope(address):
    value = safe_text(address).strip().strip("[]")
    if not value or value == "*":
        return "wildcard"
    if "%" in value:
        value = value.split("%", 1)[0]
    if value.lower().startswith("::ffff:"):
        value = value[7:]
    try:
        parsed = ipaddress.ip_address(value)
    except ValueError:
        return "unknown"
    if parsed.is_unspecified:
        return "wildcard"
    if parsed.is_loopback:
        return "loopback"
    if parsed.is_link_local:
        return "link_local"
    if parsed.is_multicast:
        return "multicast"
    if parsed.is_private:
        return "lan"
    if parsed.is_global:
        return "public"
    return "other"


def _is_remote_connection(record):
    if not isinstance(record, dict):
        return False
    if record.get("state") in ["LISTEN", "UNCONN", "CLOSED"]:
        return False
    if not record.get("remote_port"):
        return False
    return _address_scope(record.get("remote_address")) not in ["wildcard", "loopback", "multicast"]


def _adb_all_socket_text():
    commands = [
        "ss -H -tunap 2>/dev/null",
        "ss -tunap 2>/dev/null",
        "toybox netstat -tunap 2>/dev/null",
        "netstat -tunap 2>/dev/null",
    ]
    fallback = ""
    for command in commands:
        output = adb_shell(command, timeout=20)
        if output and not fallback:
            fallback = output
        if _socket_snapshot(output):
            return output
    return fallback


def _package_inventory_from_text(text):
    inventory = {}
    for raw in safe_text(text).splitlines():
        line = raw.strip()
        if not line.startswith("package:"):
            continue
        body = line[len("package:"):]
        first = body.split()[0] if body.split() else ""
        apk_path = ""
        package = first
        if "=" in first:
            apk_path, package = first.rsplit("=", 1)
        if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+", package):
            continue
        installer_match = re.search(r"\binstaller=([^\s]+)", line)
        uid_match = re.search(r"\buid[:=](\d+)\b", line)
        inventory[package] = {
            "package": package,
            "apk_path": apk_path or None,
            "installer": installer_match.group(1) if installer_match else None,
            "uid": int(uid_match.group(1)) if uid_match else None,
        }
    return inventory


def _capture_adb_package_inventory():
    output = adb_shell("pm list packages -U -i -f", timeout=28)
    inventory = _package_inventory_from_text(output)
    if not inventory:
        inventory = _package_inventory_from_text(adb_shell("pm list packages -U -i", timeout=24))
    third_party_output = adb_shell("pm list packages -3 -U", timeout=20)
    third_party = set(_package_inventory_from_text(third_party_output))
    for package, data in inventory.items():
        data["third_party"] = package in third_party
    return inventory


def _capture_uid_network_counters():
    """Obtiene contadores por UID como respaldo cuando Android oculta propietarios de sockets."""
    output = adb_shell("dumpsys netstats detail 2>/dev/null", timeout=30)
    counters = {}
    current_uid = None
    for raw in safe_text(output).splitlines():
        uid_match = re.search(r"\buid=(\d+)\b", raw)
        if uid_match:
            current_uid = int(uid_match.group(1))
        if current_uid is None:
            continue
        rx_values = [int(value) for value in re.findall(r"\brb=(\d+)\b", raw)]
        tx_values = [int(value) for value in re.findall(r"\btb=(\d+)\b", raw)]
        if not rx_values and not tx_values:
            continue
        counters[current_uid] = counters.get(current_uid, 0) + sum(rx_values) + sum(tx_values)
    return counters


def _adb_tunnel_snapshot():
    if not adb_available():
        return {"forward": [], "reverse": []}
    forward = [line.strip() for line in adb_output(["forward", "--list"], timeout=10).splitlines() if line.strip()]
    reverse = [line.strip() for line in adb_output(["reverse", "--list"], timeout=10).splitlines() if line.strip()]
    return {"forward": sorted(set(forward)), "reverse": sorted(set(reverse))}



USB_KNOWN_FUNCTIONS = {
    "adb", "mtp", "ptp", "rndis", "ncm", "midi", "accessory",
    "audio_source", "mass_storage", "diag", "serial", "acm", "dm",
    "modem", "rmnet", "qdss", "ffs",
}
USB_DATA_FUNCTIONS = {"mtp", "ptp", "rndis", "ncm", "accessory", "midi", "mass_storage"}
USB_NETWORK_FUNCTIONS = {"rndis", "ncm", "rmnet"}
USB_ENGINEERING_FUNCTIONS = {"diag", "serial", "acm", "dm", "modem", "qdss"}


def _usb_function_tokens(*values):
    text = " ".join(safe_text(value).lower() for value in values if value is not None)
    found = set()
    for name in USB_KNOWN_FUNCTIONS:
        if re.search(rf"(?<![a-z0-9_]){re.escape(name)}(?![a-z0-9_])", text):
            found.add(name)
    return sorted(found)


def _usb_bool_value(text, keys):
    raw = safe_text(text)
    for key in keys:
        match = re.search(rf"\b{re.escape(key)}\s*[:=]\s*(true|false|1|0)\b", raw, re.I)
        if match:
            return match.group(1).lower() in ("true", "1")
    return None


def _capture_usb_transport_light():
    """Muestreo ligero para detectar cambios USB transitorios durante el análisis."""
    if not adb_available() or not get_adb_connected_devices():
        return {}
    command = (
        "echo __USB_STATE__=$(getprop sys.usb.state); "
        "echo __USB_CONFIG__=$(getprop sys.usb.config); "
        "echo __USB_PERSIST__=$(getprop persist.sys.usb.config); "
        "echo __ADBD__=$(getprop init.svc.adbd); "
        "echo __FFS__=$(getprop sys.usb.ffs.ready); "
        "if [ -r /data/misc/adb/adb_keys ]; then "
        "echo __ADB_KEYS_COUNT__=$(wc -l < /data/misc/adb/adb_keys 2>/dev/null); "
        "echo __ADB_KEYS_MTIME__=$(stat -c %Y /data/misc/adb/adb_keys 2>/dev/null); fi; "
        "if [ -r /sys/class/android_usb/android0/state ]; then "
        "echo __ANDROID_USB__=$(cat /sys/class/android_usb/android0/state 2>/dev/null); fi; "
        "for f in /sys/class/udc/*/state; do if [ -r \"$f\" ]; then "
        "echo __UDC__=$f:$(cat \"$f\" 2>/dev/null); fi; done"
    )
    output = adb_shell(command, timeout=12)
    values = {
        "captured_at": datetime.now().isoformat(),
        "sys_usb_state": "",
        "sys_usb_config": "",
        "persist_usb_config": "",
        "adbd_state": "",
        "ffs_ready": "",
        "adb_keys_count": None,
        "adb_keys_mtime": None,
        "android_usb_state": "",
        "udc_states": [],
    }
    for raw in safe_text(output).splitlines():
        line = raw.strip()
        if line.startswith("__USB_STATE__="):
            values["sys_usb_state"] = line.split("=", 1)[1].strip()
        elif line.startswith("__USB_CONFIG__="):
            values["sys_usb_config"] = line.split("=", 1)[1].strip()
        elif line.startswith("__USB_PERSIST__="):
            values["persist_usb_config"] = line.split("=", 1)[1].strip()
        elif line.startswith("__ADBD__="):
            values["adbd_state"] = line.split("=", 1)[1].strip()
        elif line.startswith("__FFS__="):
            values["ffs_ready"] = line.split("=", 1)[1].strip()
        elif line.startswith("__ADB_KEYS_COUNT__="):
            raw_value = line.split("=", 1)[1].strip()
            values["adb_keys_count"] = int(raw_value) if raw_value.isdigit() else None
        elif line.startswith("__ADB_KEYS_MTIME__="):
            raw_value = line.split("=", 1)[1].strip()
            values["adb_keys_mtime"] = int(raw_value) if raw_value.isdigit() else None
        elif line.startswith("__ANDROID_USB__="):
            values["android_usb_state"] = line.split("=", 1)[1].strip()
        elif line.startswith("__UDC__="):
            values["udc_states"].append(line.split("=", 1)[1].strip())

    state_words = [values["android_usb_state"]]
    state_words.extend(item.rsplit(":", 1)[-1] for item in values["udc_states"])
    state_text = " ".join(state_words).lower()
    physical_connected = any(
        word in state_text
        for word in ["configured", "connected", "attached", "addressed", "powered", "suspended"]
    ) and not all(word in state_text for word in ["not attached"])
    functions = _usb_function_tokens(
        values["sys_usb_state"], values["sys_usb_config"], values["persist_usb_config"]
    )
    values.update({
        "functions": functions,
        "physical_connected": bool(physical_connected),
        "configured": "configured" in state_text,
        "adb_function": "adb" in functions,
        "data_functions": sorted(set(functions) & USB_DATA_FUNCTIONS),
        "network_functions": sorted(set(functions) & USB_NETWORK_FUNCTIONS),
        "engineering_functions": sorted(set(functions) & USB_ENGINEERING_FUNCTIONS),
    })
    return values


def _capture_usb_transport_state():
    """Captura completa del transporte USB/ADB visible desde shell, sin modificar el teléfono."""
    light = _capture_usb_transport_light()
    if not light:
        return {}
    dumpsys_usb = adb_shell("dumpsys usb 2>/dev/null", timeout=25)
    dumpsys_adb = adb_shell("dumpsys adb 2>/dev/null", timeout=20)
    adb_enabled = adb_shell("settings get global adb_enabled", timeout=8)
    adb_wifi_enabled = adb_shell("settings get global adb_wifi_enabled", timeout=8)
    selected_lines = []
    for raw in safe_text(dumpsys_usb).splitlines():
        lower = raw.lower()
        if any(term in lower for term in [
            "mconnected", "connected=", "mconfigured", "configured=", "hostconnected",
            "currentfunctions", "current functions", "screenunlockedfunctions", "usbdataunlocked",
            "adb", "mtp", "ptp", "rndis", "ncm", "accessory", "midi", "diag", "serial",
            "port status", "powerrole", "datarole",
        ]):
            selected_lines.append(raw.strip()[:600])
            if len(selected_lines) >= 60:
                break

    adb_service_lines = []
    for raw in safe_text(dumpsys_adb).splitlines():
        lower = raw.lower()
        if any(term in lower for term in ["usb", "wifi", "wireless", "key", "transport", "connected", "enabled", "pair"]):
            adb_service_lines.append(raw.strip()[:600])
            if len(adb_service_lines) >= 40:
                break

    dump_connected = _usb_bool_value(dumpsys_usb, ["mConnected", "connected"])
    dump_configured = _usb_bool_value(dumpsys_usb, ["mConfigured", "configured"])
    host_connected = _usb_bool_value(dumpsys_usb, ["mHostConnected", "hostConnected"])
    dump_functions = _usb_function_tokens(*selected_lines)
    functions = sorted(set(light.get("functions", [])) | set(dump_functions))
    physical_connected = bool(light.get("physical_connected") or dump_connected or dump_configured)
    configured = bool(light.get("configured") or dump_configured)
    data_functions = sorted(set(functions) & USB_DATA_FUNCTIONS)
    network_functions = sorted(set(functions) & USB_NETWORK_FUNCTIONS)
    engineering_functions = sorted(set(functions) & USB_ENGINEERING_FUNCTIONS)
    adb_function = "adb" in functions
    light.update({
        "functions": functions,
        "physical_connected": physical_connected,
        "configured": configured,
        "host_connected": bool(host_connected),
        "adb_function": adb_function,
        "adb_enabled": safe_text(adb_enabled),
        "adb_wifi_enabled": safe_text(adb_wifi_enabled),
        "adb_over_usb_candidate": bool(physical_connected and adb_function and safe_text(adb_enabled) == "1"),
        "data_functions": data_functions,
        "network_functions": network_functions,
        "engineering_functions": engineering_functions,
        "dumpsys_usb_evidence": selected_lines,
        "dumpsys_adb_evidence": adb_service_lines,
    })
    return light


def _usb_public_state(state):
    state = state or {}
    return {
        "captured_at": state.get("captured_at"),
        "physical_connected": bool(state.get("physical_connected")),
        "configured": bool(state.get("configured")),
        "host_connected": bool(state.get("host_connected")),
        "functions": state.get("functions", []),
        "data_functions": state.get("data_functions", []),
        "network_functions": state.get("network_functions", []),
        "engineering_functions": state.get("engineering_functions", []),
        "adb_function": bool(state.get("adb_function")),
        "adb_over_usb_candidate": bool(state.get("adb_over_usb_candidate")),
        "adb_enabled": state.get("adb_enabled"),
        "adb_wifi_enabled": state.get("adb_wifi_enabled"),
        "adbd_state": state.get("adbd_state"),
        "adb_keys_count": state.get("adb_keys_count"),
        "adb_keys_mtime": state.get("adb_keys_mtime"),
        "sys_usb_state": state.get("sys_usb_state"),
        "sys_usb_config": state.get("sys_usb_config"),
        "android_usb_state": state.get("android_usb_state"),
        "udc_states": state.get("udc_states", []),
        "dumpsys_usb_evidence": state.get("dumpsys_usb_evidence", [])[:30],
        "dumpsys_adb_evidence": state.get("dumpsys_adb_evidence", [])[:20],
    }


def _analyze_usb_transport_snapshot(state, phase="antes"):
    state = state or {}
    public = _usb_public_state(state)
    if not state:
        return [], {"available": False, "phase": phase}
    points = 0
    reasons = []
    if state.get("physical_connected"):
        points = max(points, 2)
        reasons.append("El teléfono reporta un enlace físico USB conectado/configurado durante la captura.")
    if state.get("adb_over_usb_candidate"):
        points = max(points, 5)
        reasons.append("La función ADB está presente mientras existe enlace físico USB; esto permite una sesión de depuración desde un host autorizado.")
    if state.get("network_functions"):
        points = max(points, 5)
        reasons.append("USB expone una función de red: " + ", ".join(state.get("network_functions", [])) + ".")
    if state.get("engineering_functions"):
        points = max(points, 6)
        reasons.append("USB expone funciones de diagnóstico/serie: " + ", ".join(state.get("engineering_functions", [])) + ".")
    if not reasons:
        reasons.append("No se observó una conexión física USB de datos en esta captura, o Android no expuso su estado.")
    finding = {
        "type": "usb_transport",
        "risk": risk_from_points(points),
        "risk_points": points,
        "confidence": "MEDIA",
        "evidence_level": "contexto_usb_transporte",
        "category": "usb_transporte",
        "indicator": "usb_transport_snapshot",
        "phase": phase,
        "value": public,
        "reasons": reasons + ["Una conexión USB o ADB autorizada puede ser legítima; se usa como evidencia contextual y debe correlacionarse con procesos, apps y actividad de red."],
        "source_group": "usb",
    }
    return [finding], {"available": True, "phase": phase, **public}


def _usb_light_signature(state):
    state = state or {}
    return (
        bool(state.get("physical_connected")),
        bool(state.get("configured")),
        tuple(state.get("functions", [])),
        safe_text(state.get("adbd_state")),
        state.get("adb_keys_count"),
        state.get("adb_keys_mtime"),
        tuple(state.get("udc_states", [])),
    )


def start_usb_transport_monitor(interval=2.5):
    """Monitor interno; no añade opciones ni mensajes a la interfaz."""
    if not adb_available() or not get_adb_connected_devices():
        return None
    stop_event = threading.Event()
    samples = []

    def worker():
        last = None
        while not stop_event.is_set():
            try:
                sample = _capture_usb_transport_light()
                signature = _usb_light_signature(sample)
                if sample and signature != last:
                    samples.append(sample)
                    if len(samples) > 80:
                        del samples[:-80]
                    last = signature
            except Exception:
                pass
            stop_event.wait(interval)

    thread = threading.Thread(target=worker, name="andreznsh-usb-monitor", daemon=True)
    thread.start()
    return {"stop": stop_event, "thread": thread, "samples": samples}


def stop_usb_transport_monitor(monitor):
    if not monitor:
        return []
    try:
        monitor["stop"].set()
        monitor["thread"].join(timeout=5)
    except Exception:
        pass
    return list(monitor.get("samples", []))


def _usb_log_events(new_log_map):
    events = []
    for key, raw in (new_log_map or {}).items():
        lower = safe_text(key).lower()
        manager = any(term in lower for term in [
            "usbdebuggingmanager", "usbdevicemanager", "usbportmanager", "android.hardware.usb"
        ])
        adbd_event = "adbd" in lower and any(term in lower for term in [
            "auth", "key", "transport", "usb", "connect", "disconnect", "allow", "deny"
        ])
        action = any(term in lower for term in [
            "connect", "disconnect", "configured", "currentfunctions", "function", "authoriz",
            "allow", "deny", "transport", "accessory", "rndis", "mtp", "ptp"
        ])
        if (manager and action) or adbd_event:
            events.append(safe_text(raw)[:520])
            if len(events) >= 30:
                break
    return events


def _analyze_usb_transport_delta(before, after, new_log_map=None, monitor_samples=None):
    before = before or {}
    after = after or {}
    monitor_samples = [sample for sample in (monitor_samples or []) if sample]
    before_public = _usb_public_state(before)
    after_public = _usb_public_state(after)
    before_functions = set(before.get("functions", []))
    observed_functions = set(after.get("functions", []))
    for sample in monitor_samples:
        observed_functions.update(sample.get("functions", []))
    added_functions = sorted(observed_functions - before_functions)

    observed_connected = bool(after.get("physical_connected") or any(x.get("physical_connected") for x in monitor_samples))
    observed_configured = bool(after.get("configured") or any(x.get("configured") for x in monitor_samples))
    observed_adb_physical = bool(
        after.get("adb_over_usb_candidate")
        or any(x.get("physical_connected") and x.get("adb_function") for x in monitor_samples)
    )
    newly_connected = bool(observed_connected and not before.get("physical_connected"))
    configured_started = bool(observed_configured and not before.get("configured"))
    adb_started = bool(observed_adb_physical and not before.get("adb_over_usb_candidate"))
    disconnected = bool(before.get("physical_connected") and not after.get("physical_connected"))
    event_lines = _usb_log_events(new_log_map)
    observed_key_counts = [x.get("adb_keys_count") for x in monitor_samples if x.get("adb_keys_count") is not None]
    if after.get("adb_keys_count") is not None:
        observed_key_counts.append(after.get("adb_keys_count"))
    before_key_count = before.get("adb_keys_count")
    key_count_increased = bool(
        before_key_count is not None and observed_key_counts and max(observed_key_counts) > before_key_count
    )
    observed_key_mtimes = [x.get("adb_keys_mtime") for x in monitor_samples if x.get("adb_keys_mtime") is not None]
    if after.get("adb_keys_mtime") is not None:
        observed_key_mtimes.append(after.get("adb_keys_mtime"))
    before_key_mtime = before.get("adb_keys_mtime")
    key_file_changed = bool(
        before_key_mtime is not None and observed_key_mtimes and max(observed_key_mtimes) > before_key_mtime
    )
    strong_auth_event = any(
        any(term in line.lower() for term in ["auth", "key", "authoriz", "allow debugging", "transport"])
        for line in event_lines
    )

    points = 0
    reasons = []
    if newly_connected:
        points += 5
        reasons.append("Se observó una conexión física USB que no estaba presente al iniciar el análisis.")
    if configured_started:
        points += 2
        reasons.append("El gadget USB pasó a estado configurado durante el análisis.")
    if adb_started:
        points += 7
        reasons.append("Apareció ADB sobre un enlace físico USB durante el análisis.")
    network_added = sorted(set(added_functions) & USB_NETWORK_FUNCTIONS)
    engineering_added = sorted(set(added_functions) & USB_ENGINEERING_FUNCTIONS)
    if network_added:
        points += 5
        reasons.append("Se habilitó una función USB de red: " + ", ".join(network_added) + ".")
    if engineering_added:
        points += 6
        reasons.append("Se habilitó una función USB de diagnóstico/serie: " + ", ".join(engineering_added) + ".")
    if "accessory" in added_functions:
        points += 3
        reasons.append("Se habilitó Android USB Accessory durante el análisis.")
    if disconnected:
        points = max(points, 4)
        reasons.append("Había enlace físico USB al inicio y dejó de estar visible antes de finalizar.")
    if event_lines and not (newly_connected or configured_started or adb_started or disconnected):
        points = max(points, 4)
        reasons.append("Logcat registró un cambio de transporte/depuración USB aunque el estado final volvió a coincidir con el inicial.")
    if key_count_increased:
        points += 9
        reasons.append("Aumentó la cantidad de claves ADB autorizadas durante el análisis; esto es compatible con la autorización de un host nuevo.")
    elif key_file_changed:
        points += 6
        reasons.append("Cambió el registro local de claves ADB autorizadas durante el análisis.")
    if strong_auth_event:
        points += 4
        reasons.append("Los eventos USB/ADBD incluyen indicios de autorización, clave o apertura de transporte.")
    points = min(points, 22)

    transitions = []
    previous = before
    for sample in monitor_samples:
        if _usb_light_signature(sample) != _usb_light_signature(previous):
            transitions.append({
                "captured_at": sample.get("captured_at"),
                "physical_connected": sample.get("physical_connected"),
                "configured": sample.get("configured"),
                "functions": sample.get("functions", []),
                "adbd_state": sample.get("adbd_state"),
                "adb_keys_count": sample.get("adb_keys_count"),
                "adb_keys_mtime": sample.get("adb_keys_mtime"),
                "udc_states": sample.get("udc_states", []),
            })
        previous = sample
    if after and _usb_light_signature(after) != _usb_light_signature(previous):
        transitions.append({
            "captured_at": after.get("captured_at"),
            "physical_connected": after.get("physical_connected"),
            "configured": after.get("configured"),
            "functions": after.get("functions", []),
            "adbd_state": after.get("adbd_state"),
            "adb_keys_count": after.get("adb_keys_count"),
            "adb_keys_mtime": after.get("adb_keys_mtime"),
            "udc_states": after.get("udc_states", []),
        })

    status = {
        "available": bool(before or after or monitor_samples),
        "before": before_public,
        "after": after_public,
        "samples_captured": len(monitor_samples),
        "transitions": transitions[:40],
        "newly_connected": newly_connected,
        "configured_started": configured_started,
        "adb_over_usb_started": adb_started,
        "disconnected_before_finish": disconnected,
        "added_functions": added_functions,
        "usb_log_events": event_lines[:20],
        "adb_key_count_increased": key_count_increased,
        "adb_key_file_changed": key_file_changed,
    }
    if points <= 0:
        return [], status
    finding = {
        "type": "usb_transport_delta",
        "risk": risk_from_points(points),
        "risk_points": points,
        "confidence": "ALTA" if (adb_started or key_count_increased or key_file_changed or strong_auth_event or len(transitions) >= 2) else "MEDIA",
        "evidence_level": "cambio_usb_durante_scan",
        "category": ("usb_adb_delta" if adb_started else ("adb_autorizacion_delta" if (key_count_increased or key_file_changed) else "usb_transporte_delta")),
        "indicator": "usb_transport_changed_during_scan",
        "phase": "durante",
        "value": status,
        "reasons": reasons + ["El cambio de USB por sí solo no confirma un cheat; se correlaciona con apps, procesos, permisos y conexiones detectados en el mismo intervalo."],
        "source_group": "usb",
    }
    return [finding], status


def _extract_package_names(text, known_packages=None):
    known = set(known_packages or [])
    found = set()
    for value in re.findall(r"\b[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+){1,}\b", safe_text(text)):
        candidate = value.split("/", 1)[0]
        if known:
            if candidate in known:
                found.add(candidate)
                continue
            matches = [pkg for pkg in known if value == pkg or value.startswith(pkg + ".")]
            if matches:
                found.add(max(matches, key=len))
        else:
            found.add(candidate)
    return found


def _adb_package_details(package):
    if package in ADB_PACKAGE_DETAILS_CACHE:
        return ADB_PACKAGE_DETAILS_CACHE[package]
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+", safe_text(package)):
        return {}
    dump = adb_shell(f"dumpsys package {shlex.quote(package)}", timeout=12)
    details = {
        "package": package,
        "first_install_time": None,
        "last_update_time": None,
        "version_name": None,
        "installer": None,
        "code_path": None,
        "uid": None,
        "labels": [],
        "permissions": [],
        "debuggable": False,
        "test_only": False,
        "has_launcher": False,
    }
    for raw in dump.splitlines():
        clean = raw.strip()
        if clean.startswith("firstInstallTime="):
            details["first_install_time"] = clean.split("=", 1)[1]
        elif clean.startswith("lastUpdateTime="):
            details["last_update_time"] = clean.split("=", 1)[1]
        elif clean.startswith("versionName="):
            details["version_name"] = clean.split("=", 1)[1]
        elif clean.startswith("installerPackageName="):
            details["installer"] = clean.split("=", 1)[1]
        elif clean.startswith("codePath="):
            details["code_path"] = clean.split("=", 1)[1]
        elif clean.startswith("userId=") and safe_text(clean.split("=", 1)[1]).isdigit():
            details["uid"] = int(clean.split("=", 1)[1])
    label_values = []
    for match in re.finditer(r"nonLocalizedLabel=(.*?)(?=\s+(?:icon|banner|logo)=|$)", dump):
        value = match.group(1).strip().strip("'\"")
        if value and value.lower() not in ["null", "none", "0"] and len(value) <= 100:
            label_values.append(value)
    details["labels"] = sorted(set(label_values))[:12]
    permission_terms = DEFAULT_RULES.get("remote_sensitive_permissions", [])
    details["permissions"] = [permission for permission in permission_terms if permission in dump]
    upper_dump = dump.upper()
    details["debuggable"] = "DEBUGGABLE" in upper_dump
    details["test_only"] = "TEST_ONLY" in upper_dump
    details["has_launcher"] = "ANDROID.INTENT.ACTION.MAIN" in upper_dump and "ANDROID.INTENT.CATEGORY.LAUNCHER" in upper_dump
    ADB_PACKAGE_DETAILS_CACHE[package] = details
    return details


def _packages_from_components(value, known_packages):
    packages = set()
    for component in re.split(r"[:,\s]+", safe_text(value)):
        package = component.split("/", 1)[0].strip()
        if package in known_packages:
            packages.add(package)
    return packages


def _recent_task_labels(text, known_packages):
    """Recupera etiquetas visibles de tareas recientes cuando Android las expone."""
    known = set(known_packages or [])
    labels = {}
    blocks = re.split(r"(?=^\s*\*?\s*(?:Recent\s+#\d+|Task\{))", safe_text(text), flags=re.M)
    for block in blocks:
        package = None
        match = re.search(
            r"(?:\bA=|\brealActivity=|\borigActivity=)([A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+)(?:/|\s|\})",
            block,
        )
        if match and match.group(1) in known:
            package = match.group(1)
        if not package:
            continue
        values = re.findall(r"\blabel=[\"']([^\"']{1,100})[\"']", block, flags=re.I)
        if values:
            labels.setdefault(package, set()).update(value.strip() for value in values if value.strip())
    return {package: sorted(values)[:8] for package, values in labels.items()}


def _capture_remote_access_state(inventory):
    known = set((inventory or {}).keys())
    extract_known = lambda value: _extract_package_names(value, known) if known else set()
    accessibility_raw = adb_shell("settings get secure enabled_accessibility_services", timeout=8)
    listeners_raw = adb_shell("settings get secure enabled_notification_listeners", timeout=8)
    overlay_raw = adb_shell("cmd appops query-op SYSTEM_ALERT_WINDOW allow 2>/dev/null", timeout=16)
    install_raw = adb_shell("cmd appops query-op REQUEST_INSTALL_PACKAGES allow 2>/dev/null", timeout=16)
    media_projection_raw = adb_shell("dumpsys media_projection 2>/dev/null", timeout=16)
    device_policy_raw = adb_shell("dumpsys device_policy 2>/dev/null", timeout=20)
    connectivity_raw = adb_shell("dumpsys connectivity 2>/dev/null", timeout=20)
    recent_tasks_raw = adb_shell("dumpsys activity recents 2>/dev/null", timeout=22)
    active_tasks_raw = adb_shell("dumpsys activity activities 2>/dev/null | head -n 1800", timeout=24)

    accessibility = _packages_from_components(accessibility_raw, known)
    listeners = _packages_from_components(listeners_raw, known)
    overlay = extract_known(overlay_raw)
    install_packages = extract_known(install_raw)
    media_projection_packages = extract_known(media_projection_raw)
    device_admin = extract_known(device_policy_raw)
    vpn_packages = extract_known(
        "\n".join(line for line in connectivity_raw.splitlines() if "vpn" in line.lower()),
    )
    projection_match = re.search(r"mProjectionGrant\s*=\s*(?!null\b)(.+)", media_projection_raw, re.I)
    projection_active = bool(projection_match or media_projection_packages)
    return {
        "accessibility": sorted(accessibility),
        "notification_listeners": sorted(listeners),
        "overlay_allowed": sorted(overlay),
        "install_packages_allowed": sorted(install_packages),
        "media_projection_active": projection_active,
        "media_projection_packages": sorted(media_projection_packages),
        "device_admin_packages": sorted(device_admin),
        "vpn_packages": sorted(vpn_packages),
        "recent_task_labels": _recent_task_labels(recent_tasks_raw + "\n" + active_tasks_raw, known),
        "media_projection_samples": [line.strip()[:500] for line in media_projection_raw.splitlines() if "projection" in line.lower()][:20],
    }


def _package_access_signals(package, access_state):
    mapping = {
        "accessibility": "accesibilidad",
        "notification_listeners": "lector_notificaciones",
        "overlay_allowed": "superposición",
        "install_packages_allowed": "instalar_apk",
        "media_projection_packages": "proyección_pantalla",
        "device_admin_packages": "administrador_dispositivo",
        "vpn_packages": "vpn",
    }
    return [label for key, label in mapping.items() if package in set(access_state.get(key, []))]


def _socket_owner(record, inventory, processes):
    process = safe_text(record.get("process"))
    pid = record.get("pid")
    uid = record.get("uid")
    if pid in processes:
        proc = processes[pid]
        process = process or safe_text(proc.get("name"))
        uid = uid or proc.get("uid")
    packages = []
    base_process = process.split(":", 1)[0]
    if base_process in inventory:
        packages.append(base_process)
    if uid is not None:
        packages.extend(pkg for pkg, data in inventory.items() if data.get("uid") == uid)
    return {
        "process": process or None,
        "pid": pid,
        "uid": uid,
        "packages": sorted(set(packages)),
    }


def _connection_sample(record, inventory, processes, phase):
    owner = _socket_owner(record, inventory, processes)
    return {
        "phase": phase,
        "protocol": record.get("proto"),
        "state": record.get("state"),
        "local_address": record.get("local_address"),
        "local_port": record.get("local_port"),
        "remote_address": record.get("remote_address"),
        "remote_port": record.get("remote_port"),
        "remote_scope": _address_scope(record.get("remote_address")),
        "process": owner.get("process"),
        "pid": owner.get("pid"),
        "uid": owner.get("uid"),
        "packages": owner.get("packages"),
        "raw": safe_text(record.get("line"))[:420],
    }


def _active_packages(processes, inventory):
    active = {}
    for record in processes.values():
        name = safe_text(record.get("name")).split(":", 1)[0]
        args = safe_text(record.get("args"))
        matches = set()
        if name in inventory:
            matches.add(name)
        for package in inventory:
            if args == package or args.startswith(package + ":") or f" {package}" in f" {args}":
                matches.add(package)
        for package in matches:
            active.setdefault(package, []).append(record.get("line"))
    return active


def _social_claims(package, labels, rules, task_labels=None):
    package_lower = safe_text(package).lower()
    label_text = " ".join(labels or []).lower()
    task_label_text = " ".join(task_labels or []).lower()
    results = []
    for brand, official_packages in rules.get("social_brand_packages", {}).items():
        brand_lower = safe_text(brand).lower()
        label_claim = bool(brand_lower and brand_lower in label_text)
        task_label_claim = bool(brand_lower and brand_lower in task_label_text)
        package_claim = bool(brand_lower and brand_lower in package_lower)
        official = package_lower in {safe_text(x).lower() for x in official_packages}
        if (label_claim or package_claim) and not official:
            results.append({
                "brand": brand_lower,
                "label_claim": label_claim,
                "task_label_claim": task_label_claim,
                "package_claim": package_claim,
                "official_packages": official_packages,
            })
    return results


def capture_adb_live_baseline():
    """Captura estado inicial estable sin limpiar logcat ni modificar el dispositivo."""
    if not adb_available() or not get_adb_connected_devices():
        return {}
    ADB_PACKAGE_DETAILS_CACHE.clear()
    epoch_text = adb_shell("date +%s", timeout=6).strip()
    try:
        device_epoch = int(epoch_text)
    except Exception:
        device_epoch = int(time.time())
    log_text = adb_shell("logcat -d -v epoch -t 5000", timeout=40)
    process_text = adb_shell("ps -A -o USER,PID,PPID,NAME,ARGS 2>/dev/null || ps -A", timeout=18)
    socket_text = _adb_all_socket_text()
    socket_snapshot = _socket_snapshot(socket_text)
    inventory = _capture_adb_package_inventory()
    return {
        "captured_at": datetime.now().isoformat(),
        "device_epoch": device_epoch,
        "logcat": _logcat_snapshot(log_text),
        "processes": _process_snapshot(process_text),
        "process_records": _process_records(process_text),
        "sockets": {key: value for key, value in socket_snapshot.items() if value.get("state") == "LISTEN"},
        "connections": {key: value for key, value in socket_snapshot.items() if _is_remote_connection(value)},
        "package_inventory": inventory,
        "third_party_packages": {
            package: data for package, data in inventory.items() if data.get("third_party")
        },
        "remote_access": _capture_remote_access_state(inventory),
        "uid_network_counters": _capture_uid_network_counters(),
        "adb_tunnels": _adb_tunnel_snapshot(),
        "usb_transport": _capture_usb_transport_state(),
    }


def _analyze_remote_guard_snapshot(
    rules,
    inventory,
    processes,
    connections,
    access_state,
    cutoff_time=None,
    phase="antes",
    package_scope=None,
):
    """Correlaciona apps, privilegios, procesos y conexiones; no sanciona por una señal aislada."""
    inventory = inventory or {}
    processes = processes or {}
    connections = connections or {}
    access_state = access_state or {}
    active = _active_packages(processes, inventory)
    samples = [
        _connection_sample(record, inventory, processes, phase)
        for record in connections.values()
        if _is_remote_connection(record)
    ]
    samples_by_package = {}
    for sample in samples:
        for package in sample.get("packages", []):
            samples_by_package.setdefault(package, []).append(sample)

    remote_terms = rules.get("remote_control_package_indicators", [])
    if package_scope is None:
        selected = {package for package, data in inventory.items() if data.get("third_party", True)}
        selected.update(active)
        selected.update(samples_by_package)
        selected.update((access_state.get("recent_task_labels", {}) or {}).keys())
        for key in [
            "accessibility", "notification_listeners", "overlay_allowed",
            "install_packages_allowed", "media_projection_packages",
            "device_admin_packages", "vpn_packages",
        ]:
            selected.update(access_state.get(key, []))
        name_terms = remote_terms + list(rules.get("social_brand_packages", {}).keys())
        selected.update(package for package in inventory if contains_any(package, name_terms))
        candidate_packages = sorted(selected)
    else:
        candidate_packages = sorted(set(package_scope))
    findings = []
    remote_packages = set()
    disguised_packages = set()
    package_status = []
    identity_status = []
    labels_visible = 0

    for package in candidate_packages:
        if package not in inventory:
            continue
        details = _adb_package_details(package)
        task_labels = (access_state.get("recent_task_labels", {}) or {}).get(package, [])
        labels = sorted(set(details.get("labels", []) + task_labels))[:16]
        if labels:
            labels_visible += 1
        combined_name = f"{package} {' '.join(labels)}"
        remote_hits = sorted(set(contains_any(combined_name, remote_terms)))
        social_claims = _social_claims(package, labels, rules, task_labels=task_labels)
        access_signals = _package_access_signals(package, access_state)
        active_lines = active.get(package, [])
        package_connections = samples_by_package.get(package, [])
        network_bytes_delta = int((access_state.get("network_byte_deltas", {}) or {}).get(package, 0) or 0)
        installer = safe_text(details.get("installer") or inventory[package].get("installer"))
        trust = installer_trust_level(installer, rules)
        first_dt = parse_android_time(details.get("first_install_time"))
        update_dt = parse_android_time(details.get("last_update_time"))
        recent = bool(cutoff_time and ((first_dt and first_dt >= cutoff_time) or (update_dt and update_dt >= cutoff_time)))

        if remote_hits:
            remote_packages.add(package)
            points = 4
            reasons = ["El paquete o su etiqueta coincide con una herramienta conocida de acceso/control remoto."]
            if active_lines:
                points += 4
                reasons.append("La aplicación tenía un proceso activo en el dispositivo.")
            if package_connections:
                points += 7
                reasons.append("El UID/proceso de la aplicación tenía una conexión remota activa.")
            elif network_bytes_delta > 0:
                points += 5
                reasons.append("Los contadores del UID registraron tráfico de red durante el escaneo, aunque Android no expuso el socket.")
            access_weights = {
                "accesibilidad": 7,
                "proyección_pantalla": 10,
                "administrador_dispositivo": 6,
                "superposición": 3,
                "instalar_apk": 3,
                "vpn": 4,
                "lector_notificaciones": 2,
            }
            for signal in access_signals:
                points += access_weights.get(signal, 1)
            if access_signals:
                reasons.append("Conserva accesos sensibles: " + ", ".join(access_signals) + ".")
            if trust in ["desconocido", "instalador_manual_sistema", "tercero"]:
                points += 2
                reasons.append("No figura una instalación inequívoca desde una tienda confiable.")
            if recent:
                points += 3
                reasons.append("Fue instalada o actualizada dentro de la ventana revisada.")
            risk = risk_from_points(points)
            findings.append({
                "type": "remote_control_app",
                "risk": risk,
                "risk_points": points,
                "confidence": confidence_from_points(points),
                "evidence_level": "capacidad_remota_correlacionada" if package_connections or access_signals or network_bytes_delta else "app_remota_instalada",
                "category": "control_remoto_app",
                "indicator": "remote_control_application",
                "package": package,
                "phase": phase,
                "value": {
                    "package": package,
                    "labels": labels,
                    "uid": details.get("uid") or inventory[package].get("uid"),
                    "installer": installer or None,
                    "hits": remote_hits,
                    "active": bool(active_lines),
                    "active_connections": package_connections[:12],
                    "network_bytes_delta": network_bytes_delta,
                    "special_access": access_signals,
                    "declared_sensitive_permissions": details.get("permissions", []),
                },
                "reasons": reasons + ["Una aplicación remota puede ser legítima; requiere correlación con la partida y autorización del jugador."],
                "source_group": "remote_app",
            })
            package_status.append({
                "package": package,
                "labels": labels,
                "hits": remote_hits,
                "active": bool(active_lines),
                "connections": len(package_connections),
                "network_bytes_delta": network_bytes_delta,
                "special_access": access_signals,
                "risk_points": points,
            })

        if social_claims:
            label_claims = [item for item in social_claims if item.get("label_claim")]
            task_label_claims = [item for item in social_claims if item.get("task_label_claim")]
            package_claims = [item for item in social_claims if item.get("package_claim")]
            points = 8 if task_label_claims else 4 if label_claims else 3
            reasons = []
            if task_label_claims:
                reasons.append("La etiqueta visible en tareas recientes afirma ser una red social o app conocida, pero el ID del paquete no coincide con los paquetes oficiales configurados.")
            elif label_claims:
                reasons.append("La etiqueta expuesta afirma ser una red social o app conocida, pero el ID del paquete no coincide con los paquetes oficiales configurados.")
            elif package_claims:
                reasons.append("El ID del paquete imita el nombre de una red social o app conocida sin coincidir con su ID oficial configurado.")
            if access_signals:
                points += min(10, 3 + (2 * len(access_signals)))
                reasons.append("La aplicación conserva accesos sensibles: " + ", ".join(access_signals) + ".")
            if remote_hits:
                points += 5
                reasons.append("Además coincide con una herramienta de control remoto.")
            if package_connections:
                points += 5
                reasons.append("Tenía conexión remota activa atribuida por UID/proceso.")
            elif network_bytes_delta > 0:
                points += 4
                reasons.append("Su UID transfirió datos durante el escaneo, aunque Android no expuso el destino remoto.")
            if active_lines:
                points += 2
                reasons.append("Tenía un proceso activo.")
            if trust in ["desconocido", "instalador_manual_sistema", "tercero"]:
                points += 2
                reasons.append("El origen de instalación no es una tienda inequívocamente confiable.")
            if details.get("debuggable") or details.get("test_only"):
                points += 2
                reasons.append("El paquete expone flags de depuración o prueba.")
            if recent:
                points += 2
                reasons.append("Fue instalada o actualizada dentro de la ventana revisada.")
            identity_material = bool(
                task_label_claims
                or (label_claims and (access_signals or remote_hits or details.get("debuggable") or details.get("test_only") or trust != "confiable_o_sistema"))
                or (package_claims and (access_signals or remote_hits or details.get("debuggable") or details.get("test_only")))
            )
            if points >= 7 and identity_material:
                disguised_packages.add(package)
                risk = risk_from_points(points)
                findings.append({
                    "type": "app_identity",
                    "risk": risk,
                    "risk_points": points,
                    "confidence": confidence_from_points(points),
                    "evidence_level": "identidad_y_capacidades_correlacionadas" if access_signals or package_connections or network_bytes_delta else "identidad_no_verificada",
                    "category": "identidad_app_camuflada",
                    "indicator": "social_identity_package_mismatch",
                    "package": package,
                    "phase": phase,
                    "value": {
                        "package": package,
                        "labels": labels,
                        "claims": social_claims,
                        "installer": installer or None,
                        "active": bool(active_lines),
                        "active_connections": package_connections[:12],
                        "network_bytes_delta": network_bytes_delta,
                        "special_access": access_signals,
                    },
                    "reasons": reasons + ["Esto detecta una incoherencia de identidad; no confirma por sí solo que la app sea un cheat."],
                    "source_group": "package_identity",
                })
                identity_status.append({
                    "package": package,
                    "labels": labels,
                    "claims": social_claims,
                    "active": bool(active_lines),
                    "connections": len(package_connections),
                    "network_bytes_delta": network_bytes_delta,
                    "special_access": access_signals,
                    "risk_points": points,
                })


        # Heurística para herramientas remotas personalizadas o renombradas: no depende del nombre.
        known_official = {
            safe_text(pkg).lower()
            for packages in rules.get("social_brand_packages", {}).values()
            for pkg in packages
        }
        capability_set = set(access_signals)
        core_capabilities = capability_set & {"accesibilidad", "proyección_pantalla", "administrador_dispositivo"}
        generic_points = 0
        generic_reasons = []
        if package.lower() not in known_official and not remote_hits and not social_claims:
            weights = {
                "proyección_pantalla": 8,
                "accesibilidad": 6,
                "administrador_dispositivo": 5,
                "superposición": 2,
                "instalar_apk": 2,
                "vpn": 2,
                "lector_notificaciones": 1,
            }
            for signal in capability_set:
                generic_points += weights.get(signal, 0)
            if package_connections:
                generic_points += 6
                generic_reasons.append("El proceso/UID mantiene una conexión remota visible.")
            elif network_bytes_delta > 0:
                generic_points += 4
                generic_reasons.append("El UID transfirió datos durante el análisis aunque Android no expuso el destino.")
            if active_lines:
                generic_points += 2
                generic_reasons.append("La aplicación tenía proceso activo.")
            if recent:
                generic_points += 2
                generic_reasons.append("La aplicación fue instalada o actualizada recientemente.")
            if trust in ["desconocido", "instalador_manual_sistema", "tercero"]:
                generic_points += 2
                generic_reasons.append("El origen de instalación no es inequívocamente confiable.")
            multi_capability = len(capability_set & {
                "accesibilidad", "proyección_pantalla", "administrador_dispositivo",
                "superposición", "instalar_apk", "vpn"
            }) >= 2
            has_network_evidence = bool(package_connections or network_bytes_delta > 0)
            material = bool(core_capabilities and (multi_capability or has_network_evidence))
            if material and generic_points >= 12:
                findings.append({
                    "type": "remote_capability_app",
                    "risk": risk_from_points(generic_points),
                    "risk_points": generic_points,
                    "confidence": confidence_from_points(generic_points),
                    "evidence_level": "capacidades_remotas_correlacionadas",
                    "category": "capacidad_control_remoto_generica",
                    "indicator": "unnamed_remote_control_capability",
                    "package": package,
                    "phase": phase,
                    "value": {
                        "package": package,
                        "labels": labels,
                        "active": bool(active_lines),
                        "active_connections": package_connections[:12],
                        "network_bytes_delta": network_bytes_delta,
                        "special_access": access_signals,
                        "declared_sensitive_permissions": details.get("permissions", []),
                        "installer": installer or None,
                    },
                    "reasons": [
                        "La app combina capacidades que pueden permitir control/observación remota sin depender de un nombre conocido: "
                        + ", ".join(sorted(capability_set)) + "."
                    ] + generic_reasons + [
                        "Esta correlación detecta capacidad técnica, no prueba intención ni uso durante una partida."
                    ],
                    "source_group": "remote_app",
                })
                remote_packages.add(package)

    suspicious_ports = {int(value) for value in rules.get("suspicious_remote_ports", [])}
    remote_ports = {int(value) for value in rules.get("remote_control_ports", [])}
    strong_injection_ports = {23946, 23947, 27042, 27043, 31337}
    flagged_connections = []
    top_points = 0
    for sample in samples:
        packages = set(sample.get("packages", []))
        owner_text = f"{sample.get('process')} {' '.join(packages)}"
        owner_remote_hits = sorted(set(contains_any(owner_text, remote_terms)))
        port = sample.get("remote_port")
        owner_remote = bool(packages.intersection(remote_packages) or owner_remote_hits)
        owner_disguised = bool(packages.intersection(disguised_packages))
        weak_proxy_port = port in {8080, 8888}
        sensitive_destination = port in suspicious_ports and (not weak_proxy_port or owner_remote or owner_disguised)
        if not sensitive_destination and port not in remote_ports and not owner_remote and not owner_disguised:
            continue
        points = 0
        flags = []
        if port in strong_injection_ports:
            points += 15
            flags.append("puerto_inyección")
        elif sensitive_destination:
            points += 8
            flags.append("puerto_sensible")
        if port in remote_ports:
            points += 9
            flags.append("puerto_control_remoto")
        if owner_remote:
            points += 7
            flags.append("propietario_app_remota")
        if owner_disguised:
            points += 6
            flags.append("propietario_identidad_incoherente")
        if sample.get("remote_scope") == "public":
            points += 1
        if phase == "durante":
            points += 2
        sample = dict(sample)
        sample["signals"] = flags
        sample["risk_points"] = points
        flagged_connections.append(sample)
        top_points = max(top_points, points)
    if flagged_connections:
        points = max(8, top_points)
        findings.append({
            "type": "remote_connection",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": confidence_from_points(points),
            "evidence_level": "conexion_uid_proceso_paquete" if any(x.get("packages") for x in flagged_connections) else "conexion_sin_propietario_visible",
            "category": "conexiones_remotas_activas" if phase == "antes" else "conexiones_remotas_delta",
            "indicator": "sensitive_remote_connection",
            "phase": phase,
            "value": flagged_connections[:30],
            "reasons": [
                "Se detectaron conexiones remotas asociadas a un puerto sensible o a un proceso/paquete de control remoto.",
                "Las conexiones HTTPS normales no se marcan si no existe otra señal atribuible.",
            ],
            "source_group": "remote_connection",
        })

    attributed = sum(1 for item in samples if item.get("packages") or item.get("process"))
    status = {
        "phase": phase,
        "connections_visible": len(samples),
        "connections_attributed": attributed,
        "sensitive_connections": len(flagged_connections),
        "connection_samples": samples[:40],
        "sensitive_connection_samples": flagged_connections[:30],
        "remote_control_apps": package_status[:40],
        "identity_mismatches": identity_status[:40],
        "network_byte_deltas": access_state.get("network_byte_deltas", {}),
        "labels_exposed": labels_visible,
        "packages_evaluated": len(candidate_packages),
        "access_state": access_state,
        "visibility": "COMPLETA_EN_DATOS_VISIBLES" if samples and attributed == len(samples) else "PARCIAL_POR_RESTRICCIONES_ANDROID",
    }
    return findings, status


def scan_adb_live_delta(rules, baseline, cutoff_time=None, usb_monitor_samples=None):
    """Detecta eventos, procesos y puertos que aparecieron durante el escaneo."""
    summary = {
        "baseline_captured": bool(baseline),
        "captured_at": baseline.get("captured_at") if baseline else None,
        "new_log_events": 0,
        "suspicious_log_events": 0,
        "new_processes": 0,
        "suspicious_new_processes": 0,
        "new_sockets": 0,
        "suspicious_new_ports": 0,
        "new_remote_connections": 0,
        "suspicious_new_remote_connections": 0,
        "new_third_party_packages": 0,
        "new_remote_access_grants": 0,
        "uids_with_network_activity": 0,
        "network_activity_bytes": 0,
        "new_adb_tunnels": 0,
        "usb_transport_changes": 0,
        "usb_adb_started": False,
        "usb_guard": {},
        "new_process_samples": [],
        "new_port_samples": [],
        "new_remote_connection_samples": [],
        "new_package_samples": [],
        "remote_guard": {},
    }
    if not baseline or not get_adb_connected_devices():
        return [], summary

    epoch = baseline.get("device_epoch")
    log_text = ""
    if epoch:
        log_text = adb_shell(f"logcat -d -v epoch -T {int(epoch)}.000", timeout=40)
        if "invalid option" in log_text.lower() or "usage:" in log_text.lower():
            log_text = ""
    if log_text:
        new_log_map = _logcat_snapshot(log_text)
    else:
        after_log = _logcat_snapshot(adb_shell("logcat -d -v epoch -t 5000", timeout=40))
        new_log_map = {k: v for k, v in after_log.items() if k not in baseline.get("logcat", {})}

    after_process_text = adb_shell("ps -A -o USER,PID,PPID,NAME,ARGS 2>/dev/null || ps -A", timeout=18)
    after_processes = _process_snapshot(after_process_text)
    after_process_records = _process_records(after_process_text)
    new_process_map = {k: v for k, v in after_processes.items() if k not in baseline.get("processes", {})}
    all_after_sockets = _socket_snapshot(_adb_all_socket_text())
    after_sockets = {key: value for key, value in all_after_sockets.items() if value.get("state") == "LISTEN"}
    after_connections = {key: value for key, value in all_after_sockets.items() if _is_remote_connection(value)}
    new_socket_map = {k: v for k, v in after_sockets.items() if k not in baseline.get("sockets", {})}
    new_connection_map = {k: v for k, v in after_connections.items() if k not in baseline.get("connections", {})}
    after_inventory = _capture_adb_package_inventory()
    before_inventory = baseline.get("package_inventory") or baseline.get("third_party_packages", {})
    new_packages = sorted(set(after_inventory) - set(before_inventory))
    new_third_party_packages = [
        package for package in new_packages if after_inventory.get(package, {}).get("third_party", True)
    ]
    after_access = _capture_remote_access_state(after_inventory)
    before_access = baseline.get("remote_access", {})
    after_uid_counters = _capture_uid_network_counters()
    before_uid_counters = baseline.get("uid_network_counters", {})
    uid_network_delta = {
        uid: total - int(before_uid_counters.get(uid, 0))
        for uid, total in after_uid_counters.items()
        if total > int(before_uid_counters.get(uid, 0))
    }
    package_network_delta = {}
    for package, data in after_inventory.items():
        uid = data.get("uid")
        if uid in uid_network_delta:
            package_network_delta[package] = uid_network_delta[uid]
    after_access["network_byte_deltas"] = package_network_delta
    after_adb_tunnels = _adb_tunnel_snapshot()
    before_adb_tunnels = baseline.get("adb_tunnels", {"forward": [], "reverse": []})
    adb_tunnel_delta = {
        direction: sorted(set(after_adb_tunnels.get(direction, [])) - set(before_adb_tunnels.get(direction, [])))
        for direction in ["forward", "reverse"]
    }
    adb_tunnel_delta = {key: value for key, value in adb_tunnel_delta.items() if value}
    after_usb_transport = _capture_usb_transport_state()
    usb_delta_findings, usb_delta_status = _analyze_usb_transport_delta(
        baseline.get("usb_transport", {}),
        after_usb_transport,
        new_log_map=new_log_map,
        monitor_samples=usb_monitor_samples or [],
    )

    access_delta = {}
    for key in [
        "accessibility", "notification_listeners", "overlay_allowed",
        "install_packages_allowed", "media_projection_packages",
        "device_admin_packages", "vpn_packages",
    ]:
        added = sorted(set(after_access.get(key, [])) - set(before_access.get(key, [])))
        if added:
            access_delta[key] = added
    projection_started = bool(after_access.get("media_projection_active") and not before_access.get("media_projection_active"))

    summary["new_log_events"] = len(new_log_map)
    summary["new_processes"] = len(new_process_map)
    summary["new_sockets"] = len(new_socket_map)
    summary["new_remote_connections"] = len(new_connection_map)
    summary["new_third_party_packages"] = len(new_third_party_packages)
    summary["new_remote_access_grants"] = sum(len(value) for value in access_delta.values()) + int(projection_started)
    summary["uids_with_network_activity"] = len(uid_network_delta)
    summary["network_activity_bytes"] = sum(uid_network_delta.values())
    summary["new_adb_tunnels"] = sum(len(value) for value in adb_tunnel_delta.values())
    summary["usb_guard"] = usb_delta_status
    summary["usb_transport_changes"] = len(usb_delta_status.get("transitions", []))
    summary["usb_adb_started"] = bool(usb_delta_status.get("adb_over_usb_started"))
    summary["network_activity_packages"] = [
        {"package": package, "bytes_delta": value}
        for package, value in sorted(package_network_delta.items(), key=lambda item: item[1], reverse=True)[:20]
    ]
    summary["new_process_samples"] = list(new_process_map.values())[:12]
    summary["new_package_samples"] = new_third_party_packages[:20]

    findings = list(usb_delta_findings)
    suspicious_log = []
    benign_terms = rules.get("benign_log_terms", [])
    strong_terms = ["frida", "xposed", "lsposed", "gameguardian", "androidgg", "ptrace", "zygisk", "magisk", "kernelsu", "apatch"]
    for key, raw in new_log_map.items():
        hits = sorted(set(contains_any(key, rules.get("suspicious_log_keywords", []))))
        if not hits:
            continue
        if contains_any(key, benign_terms) and not any(term in key for term in strong_terms):
            continue
        suspicious_log.append({"event": raw[:500], "hits": hits[:8]})
    if suspicious_log:
        joined = " ".join(x["event"].lower() for x in suspicious_log)
        points = 20 if any(x in joined for x in strong_terms) else 10
        findings.append({
            "type": "live_event", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "ALTA" if points >= 15 else "MEDIA", "evidence_level": "evento_nuevo_durante_scan",
            "category": "eventos_logcat_delta", "indicator": "new_suspicious_logcat_events",
            "value": suspicious_log[:20],
            "reasons": ["Logcat registró eventos sensibles después de iniciar el escaneo."],
            "source_group": "logcat"
        })
    summary["suspicious_log_events"] = len(suspicious_log)

    suspicious_processes = []
    process_terms = rules.get("suspicious_process_keywords", []) + rules.get("remote_control_package_indicators", [])
    for key, raw in new_process_map.items():
        hits = sorted(set(contains_any(key, process_terms)))
        if hits:
            suspicious_processes.append({"process": raw[:420], "hits": hits[:8]})
    if suspicious_processes:
        points = 22
        findings.append({
            "type": "process_delta", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "ALTA", "evidence_level": "proceso_nuevo_durante_scan",
            "category": "procesos_delta", "indicator": "new_suspicious_process_during_scan",
            "value": suspicious_processes[:20],
            "reasons": ["Apareció un proceso nuevo con nombre o argumentos sensibles durante el escaneo."],
            "source_group": "process"
        })
    summary["suspicious_new_processes"] = len(suspicious_processes)

    suspicious_ports = {
        int(x) for x in rules.get("suspicious_remote_ports", []) + rules.get("remote_control_ports", [])
    }
    profiles = {int(k): v for k, v in rules.get("suspicious_port_profiles", {}).items() if str(k).isdigit()}
    port_hits = []
    contextual = []
    for record in new_socket_map.values():
        port = record.get("local_port")
        if not port or port not in suspicious_ports:
            continue
        line = record.get("line", "")
        item = {"port": port, "profile": profiles.get(port, "Puerto sensible"), "process": record.get("process") or "N/D", "line": line[:360]}
        if port in (5037, 5555) and not _socket_is_public(line):
            contextual.append(item)
        else:
            port_hits.append(item)
    summary["new_port_samples"] = port_hits[:12]
    summary["contextual_adb_ports"] = len(contextual)
    if port_hits:
        strong = {23946, 23947, 27042, 27043, 31337}
        points = 21 if any(x["port"] in strong for x in port_hits) else 11
        findings.append({
            "type": "network", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "ALTA" if points >= 15 else "MEDIA", "evidence_level": "puerto_nuevo_durante_scan",
            "category": "puertos_delta", "indicator": "new_suspicious_listening_port",
            "value": port_hits[:20],
            "reasons": ["Se abrió un puerto sensible después de iniciar el escaneo."],
            "source_group": "port"
        })
    summary["suspicious_new_ports"] = len(port_hits)

    candidate_packages = set(new_packages)
    access_packages = set()
    for key in [
        "accessibility", "notification_listeners", "overlay_allowed",
        "install_packages_allowed", "media_projection_packages",
        "device_admin_packages", "vpn_packages",
    ]:
        access_packages.update(after_access.get(key, []))
    task_label_packages = set((after_access.get("recent_task_labels", {}) or {}).keys())
    name_terms = rules.get("remote_control_package_indicators", []) + list(rules.get("social_brand_packages", {}).keys())
    candidate_packages.update(
        package for package in package_network_delta
        if after_inventory.get(package, {}).get("third_party")
        or contains_any(package, name_terms)
        or package in access_packages
        or package in task_label_packages
    )
    for record in new_connection_map.values():
        candidate_packages.update(_socket_owner(record, after_inventory, after_process_records).get("packages", []))
    for record in after_process_records.values():
        if _normalize_process_identity(record.get("line")) not in new_process_map:
            continue
        process_name = safe_text(record.get("name")).split(":", 1)[0]
        if process_name in after_inventory:
            candidate_packages.add(process_name)
        for package in after_inventory:
            args = safe_text(record.get("args"))
            if args == package or args.startswith(package + ":"):
                candidate_packages.add(package)
    for packages in access_delta.values():
        candidate_packages.update(packages)

    remote_delta_findings, remote_delta_status = _analyze_remote_guard_snapshot(
        rules,
        after_inventory,
        after_process_records,
        new_connection_map,
        after_access,
        cutoff_time=cutoff_time,
        phase="durante",
        package_scope=candidate_packages,
    )
    findings.extend(remote_delta_findings)
    summary["remote_guard"] = remote_delta_status
    summary["suspicious_new_remote_connections"] = remote_delta_status.get("sensitive_connections", 0)
    summary["new_remote_connection_samples"] = remote_delta_status.get("connection_samples", [])[:20]

    if new_third_party_packages:
        points = 6
        findings.append({
            "type": "package_delta",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": "ALTA",
            "evidence_level": "paquete_aparecido_durante_scan",
            "category": "apps_delta",
            "indicator": "third_party_package_installed_during_scan",
            "value": new_third_party_packages[:30],
            "reasons": ["Apareció una aplicación de terceros que no estaba instalada al iniciar el escaneo."],
            "source_group": "package",
        })

    if access_delta:
        points = 11
        findings.append({
            "type": "special_access_delta",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": "ALTA",
            "evidence_level": "permiso_especial_habilitado_durante_scan",
            "category": "accesos_delta",
            "indicator": "special_access_enabled_during_scan",
            "value": access_delta,
            "reasons": ["Una aplicación obtuvo un acceso especial después de iniciar el escaneo; revisar el paquete y la acción realizada."],
            "source_group": "special_access",
        })

    if projection_started:
        points = 13
        findings.append({
            "type": "screen_capture_delta",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": "ALTA",
            "evidence_level": "proyeccion_pantalla_iniciada_durante_scan",
            "category": "control_remoto_delta",
            "indicator": "media_projection_started_during_scan",
            "value": {
                "packages": after_access.get("media_projection_packages", []),
                "samples": after_access.get("media_projection_samples", []),
            },
            "reasons": ["Android registró una proyección/captura de pantalla que no estaba activa al comenzar."],
            "source_group": "special_access",
        })
    if adb_tunnel_delta:
        points = 14
        findings.append({
            "type": "adb_remote",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": "ALTA",
            "evidence_level": "túnel_adb_creado_durante_scan",
            "category": "adb_tuneles_delta",
            "indicator": "adb_tunnel_created_during_scan",
            "value": adb_tunnel_delta,
            "reasons": ["Se creó una redirección adb forward/reverse después de iniciar el escaneo."],
            "source_group": "adb_tunnel",
        })
    return findings, summary


def scan_adb_remote_connection_indicators(rules, baseline=None, cutoff_time=None):
    """Muestra el estado Termux/ADB diferenciando contexto esperado de exposición real."""
    status = {
        "available": False,
        "termux_service_active": False,
        "wireless_adb_active": False,
        "termux_adb_server_active": False,
        "adb_publicly_exposed": False,
        "manual_activation_log_evidence": False,
        "remote_guard": {},
        "details": {},
    }
    if not adb_available() or not get_adb_connected_devices():
        return [], status

    status["available"] = True
    processes = adb_shell("ps -A -o USER,PID,PPID,NAME,ARGS 2>/dev/null || ps -A", timeout=18)
    services = adb_shell("dumpsys activity services com.termux 2>/dev/null | head -n 500", timeout=22)
    sockets = adb_shell("ss -lntup 2>/dev/null || toybox netstat -lntup 2>/dev/null || netstat -lntup 2>/dev/null", timeout=18)
    recent_log = adb_shell("logcat -d -v threadtime -t 1800", timeout=30)

    guard_inventory = (
        (baseline or {}).get("package_inventory")
        or (baseline or {}).get("third_party_packages")
        or _capture_adb_package_inventory()
    )
    guard_processes = (baseline or {}).get("process_records") or _process_records(processes)
    guard_connections = (baseline or {}).get("connections")
    if guard_connections is None:
        guard_connections = {
            key: value for key, value in _socket_snapshot(_adb_all_socket_text()).items()
            if _is_remote_connection(value)
        }
    guard_access = (baseline or {}).get("remote_access") or _capture_remote_access_state(guard_inventory)
    guard_findings, guard_status = _analyze_remote_guard_snapshot(
        rules,
        guard_inventory,
        guard_processes,
        guard_connections,
        guard_access,
        cutoff_time=cutoff_time,
        phase="antes",
    )
    status["remote_guard"] = guard_status
    usb_before = (baseline or {}).get("usb_transport") or _capture_usb_transport_state()
    usb_before_findings, usb_before_status = _analyze_usb_transport_snapshot(usb_before, phase="antes")
    status["usb_guard"] = usb_before_status

    settings = {
        "adb_enabled": adb_shell("settings get global adb_enabled", timeout=8),
        "adb_wifi_enabled": adb_shell("settings get global adb_wifi_enabled", timeout=8),
        "adb_tcp_port": adb_shell("settings get global adb_tcp_port", timeout=8),
        "service.adb.tcp.port": adb_shell("getprop service.adb.tcp.port", timeout=8),
        "persist.adb.tcp.port": adb_shell("getprop persist.adb.tcp.port", timeout=8),
        "init.svc.adbd": adb_shell("getprop init.svc.adbd", timeout=8),
    }
    status["details"]["settings"] = settings

    combined_termux = f"{processes}\n{services}".lower()
    status["termux_service_active"] = "com.termux" in combined_termux and any(
        x in combined_termux for x in ["termuxservice", "runcommandservice", "terminalservice", "com.termux"]
    )

    tcp_values = [settings.get("adb_tcp_port"), settings.get("service.adb.tcp.port"), settings.get("persist.adb.tcp.port")]
    tcp_active = any(safe_text(v) not in ["", "0", "-1", "null", "undefined"] for v in tcp_values)
    status["wireless_adb_active"] = settings.get("adb_wifi_enabled") == "1" or tcp_active

    process_lines = []
    for line in processes.splitlines():
        lower = line.lower()
        if re.search(r"(^|\s)adb(\s|$)", lower) and "adbd" not in lower:
            process_lines.append(line.strip()[:420])
    socket_5037 = [line.strip()[:420] for line in sockets.splitlines() if re.search(r":5037(?:\s|$)", line)]
