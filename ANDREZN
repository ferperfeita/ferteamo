def _make_def_finding(category, indicator, points, reason, value=None, evidence="indicio", ftype="advanced"):
    points = max(0, int(points))
    return {
        "type": ftype,
        "risk": "NINGUNO" if points <= 0 else risk_from_points(points),
        "risk_points": points,
        "confidence": "ALTA" if evidence in ("directo", "integridad_confirmada") else ("MEDIA" if points >= 7 else "BAJA"),
        "evidence_level": evidence,
        "category": category,
        "indicator": indicator,
        "value": value if value is not None else indicator,
        "reasons": [reason],
    }


def _ff_installed_packages_adb(rules):
    out = []
    for pkg in rules.get("free_fire_packages", ["com.dts.freefireth", "com.dts.freefiremax"]):
        if not re.fullmatch(r"[A-Za-z0-9._]+", safe_text(pkg)):
            continue
        if adb_shell(f"pm path {shlex.quote(pkg)} 2>/dev/null", timeout=4).startswith("package:"):
            out.append(pkg)
    return out


def scan_game_memory_maps_adb(rules):
    """Busca señales de hooking/inyección dentro de maps del proceso del juego cuando Android lo permite."""
    status = {"available": False, "targets": 0, "readable": 0, "denied": 0, "suspicious_maps": 0, "rwx": 0, "memfd_exec": 0}
    findings = []
    if not adb_available() or not get_adb_connected_devices():
        return findings, status
    status["available"] = True
    terms = ["frida", "frida-agent", "frida-gadget", "gadget", "xposed", "lsposed", "edxposed", "substrate", "gameguardian", "androidgg", "objection"]
    for pkg in _ff_installed_packages_adb(rules):
        pids = re.findall(r"\b\d+\b", adb_shell(f"pidof {shlex.quote(pkg)} 2>/dev/null", timeout=4))
        for pid in pids[:4]:
            status["targets"] += 1
            maps = adb_shell(f"cat /proc/{pid}/maps 2>/dev/null | head -12000", timeout=7)
            if not maps.strip():
                status["denied"] += 1
                continue
            status["readable"] += 1
            low = maps.lower()
            hit_terms = sorted({t for t in terms if t in low})
            rwx_lines = [ln for ln in maps.splitlines() if re.search(r"\brwx[ps-]", ln)]
            memfd_exec = [ln for ln in maps.splitlines() if ("memfd:" in ln.lower() or "/dev/ashmem" in ln.lower()) and re.search(r"\br.x[ps-]", ln)]
            deleted_exec = [ln for ln in maps.splitlines() if "(deleted)" in ln.lower() and re.search(r"\br.x[ps-]", ln)]
            status["suspicious_maps"] += len(hit_terms)
            status["rwx"] += len(rwx_lines)
            status["memfd_exec"] += len(memfd_exec)
            if hit_terms:
                findings.append(_make_def_finding(
                    "hooking_inyeccion", "hook_mapping_inside_free_fire", 22,
                    "Se observó una librería o marcador de instrumentación dentro del mapa de memoria de Free Fire.",
                    {"package": pkg, "signals": hit_terms[:8]}, "directo", "memory_map"))
            if memfd_exec or deleted_exec:
                findings.append(_make_def_finding(
                    "memoria_juego", "anonymous_executable_mapping", 10,
                    "Free Fire contiene un mapeo ejecutable anónimo/eliminado. Puede ser JIT legítimo; requiere correlación.",
                    {"package": pkg, "memfd_exec": len(memfd_exec), "deleted_exec": len(deleted_exec)}, "indicio", "memory_map"))
            if len(rwx_lines) >= 3:
                findings.append(_make_def_finding(
                    "memoria_juego", "multiple_rwx_regions", 4,
                    "Se observaron varias regiones RWX en el proceso del juego. ART/JIT puede producirlas, por eso se conserva solo como contexto.",
                    {"package": pkg, "rwx_count": len(rwx_lines)}, "contexto", "memory_map"))
    status["coverage"] = "readable" if status["readable"] else ("restricted" if status["targets"] else "game_not_running")
    return findings, status


