def clear_screen():
    # Fondo negro ANSI y limpieza completa de la terminal.
    if sys.stdout.isatty():
        print("\033[40m\033[2J\033[H", end="", flush=True)
    else:
        os.system("clear")


def typewrite(text, delay=0.002, color=""):
    if not sys.stdout.isatty():
        print(f"{color}{text}{RESET}")
        return
    print(color, end="", flush=True)
    for char in text:
        print(char, end="", flush=True)
        time.sleep(delay)
    print(RESET)


def pulse_line(text, cycles=1):
    """Muestra un pulso breve sin alterar la lógica del análisis."""
    if not sys.stdout.isatty():
        print(f"{BRIGHT_RED}●{RESET} {text}")
        return
    for _ in range(max(1, cycles)):
        for color in (DARK_RED, LIGHT_RED, BRIGHT_RED):
            print(f"\r\033[2K{color}●{RESET} {WHITE}{text}{RESET}", end="", flush=True)
            time.sleep(0.045)
    print(f"\r\033[2K{BRIGHT_RED}●{RESET} {WHITE}{text}{RESET}")


def animate_boot_sequence():
    global INTRO_PLAYED
    if INTRO_PLAYED:
        return
    INTRO_PLAYED = True
    clear_screen()
    lines = [
        "[BOOT] ANDREZN",
        "[ADB ] Preparando conexión...",
        "[SCAN] Preparando análisis...",
        "[WEB ] Preparando resultados...",
    ]
    for index, line in enumerate(lines):
        typewrite(line, 0.0015, BRIGHT_RED if index in (0, 2) else WHITE)
        time.sleep(0.04)
    width = 28
    if sys.stdout.isatty():
        for i in range(width + 1):
            filled = "█" * i
            empty = "░" * (width - i)
            pct = int(i * 100 / width)
            print(f"\r{DARK_RED}[{BRIGHT_RED}{filled}{DARK_GRAY}{empty}{DARK_RED}]{RESET} {pct:3d}%", end="", flush=True)
            time.sleep(0.012)
        print()
    else:
        print(f"{BRIGHT_RED}[{'█' * width}]{RESET} 100%")
    typewrite("[OK] ANDREZN LISTO", 0.002, GREEN)
    time.sleep(0.15)


def safe_text(value):
    if value is None:
        return ""
    value = str(value)
    value = value.strip()
    return value


def safe_filename(value):
    value = safe_text(value)
    value = re.sub(r"[^a-zA-Z0-9_\-.]+", "_", value)
    return value[:80] if value else "sin_dato"


def run_command(command, timeout=8):
    try:
        output = subprocess.check_output(
            command,
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=timeout
        )
        return output.strip()
    except Exception:
        return ""


def command_exists(name):
    return shutil.which(name) is not None


def run_command_visible(command, timeout=20):
    """Ejecuta un comando y devuelve stdout+stderr. Solo lectura."""
    try:
        proc = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout
        )
        return proc.stdout.strip()
    except Exception as exc:
        return f"ERROR: {exc}"


def adb_available():
    return command_exists("adb")


def adb_output(args=None, timeout=15):
    if args is None:
        args = []
    if not adb_available():
        return ""
    return run_command(["adb"] + list(args), timeout=timeout)


def adb_output_visible(args=None, timeout=20):
    if args is None:
        args = []
    if not adb_available():
        return "ADB no esta instalado. Instala android-tools."
    return run_command_visible(["adb"] + list(args), timeout=timeout)


def adb_shell(command, timeout=15):
    if isinstance(command, str):
        return adb_output(["shell", command], timeout=timeout)
    return adb_output(["shell"] + list(command), timeout=timeout)


def adb_shell_visible(command, timeout=20):
    if isinstance(command, str):
        return adb_output_visible(["shell", command], timeout=timeout)
    return adb_output_visible(["shell"] + list(command), timeout=timeout)


def parse_adb_devices(output):
    devices = []
    for line in safe_text(output).splitlines():
        line = line.strip()
        if not line or line.lower().startswith("list of devices"):
            continue
        parts = line.split()
        if len(parts) >= 2:
            devices.append({"serial": parts[0], "state": parts[1]})
    return devices


def get_adb_devices():
    return parse_adb_devices(adb_output(["devices"], timeout=8))


def get_adb_connected_devices():
    return [d for d in get_adb_devices() if d.get("state") == "device"]


def adb_status_text():
    if not adb_available():
        return f"{RED}adb no instalado{RESET}"
    devices = get_adb_devices()
    connected = [d for d in devices if d.get("state") == "device"]
    if connected:
        serials = ", ".join(d["serial"] for d in connected[:2])
        return f"{GREEN}Conectado{RESET} {DIM}({serials}){RESET}"
    if devices:
        states = ", ".join(f"{d['serial']}:{d['state']}" for d in devices[:2])
        return f"{SCARLET}Detectado sin autorizacion{RESET} {DIM}({states}){RESET}"
    return f"{RED}No conectado{RESET}"


def normalize_adb_addr(value, default_host="127.0.0.1"):
    value = safe_text(value).replace(" ", "")
    if not value:
        return ""
    if ":" in value:
        return value
    if value.isdigit():
        return f"{default_host}:{value}"
    return value


