            "first_install_time": details.get("first_install_time"),
            "last_update_time": details.get("last_update_time"),
            "recent_install": recent_install,
            "recent_update": recent_update,
            "change_type": change_type,
            "keyword_hits": sorted(set(keyword_hits)),
            "reasons": reasons,
        })

    return findings


def read_setting(scope, key):
    return run_command(["settings", "get", scope, key], timeout=5)


def normalize_setting(value):
    value = safe_text(value)
    if value.lower() in ["null", "undefined", "none", ""]:
        return ""
    return value


def get_dns_state(rules):
    state = {}
    for key in rules.get("dns_watch_keys", []):
        state[key] = normalize_setting(read_setting("global", key))

    props_raw = run_command(["getprop"], timeout=6)
    dns_props = {}
    for line in props_raw.splitlines():
        clean = line.strip()
        if "dns" in clean.lower() or "netd" in clean.lower():
            m = re.match(r"\[(.*?)\]: \[(.*?)\]", clean)
            if m:
                dns_props[m.group(1)] = m.group(2)
    state["getprop_dns_related"] = dns_props

    return state


def scan_dns_indicators(rules):
    findings = []
    state = get_dns_state(rules)
    mode = safe_text(state.get("private_dns_mode")).lower()
    specifier = safe_text(state.get("private_dns_specifier"))
    default_mode = safe_text(state.get("private_dns_default_mode"))
    validated = safe_text(state.get("private_dns_validated_server"))

    if mode and mode not in ["off", "opportunistic"]:
        points = 14 if specifier else 10
        reasons = ["DNS privado en modo estricto/personalizado detectado"]
        if specifier:
            reasons.append(f"Servidor DNS privado configurado: {specifier}")
        findings.append({
            "type": "network",
            "risk": risk_from_points(points),
            "risk_points": points,
            "indicator": "private_dns_custom_strict",
            "value": {"mode": mode, "specifier": specifier, "default_mode": default_mode, "validated_server": validated},
            "reasons": reasons,
        })
    elif specifier:
        points = 9
        reasons = ["Servidor DNS privado especificado aunque el modo no sea estricto"]
        findings.append({
            "type": "network",
            "risk": risk_from_points(points),
            "risk_points": points,
            "indicator": "private_dns_specifier_present",
            "value": {"mode": mode, "specifier": specifier},
            "reasons": reasons,
        })

    dns_terms = contains_any(f"{specifier} {validated}", rules.get("dns_suspicious_terms", []))
    if dns_terms:
        points = 11
        findings.append({
            "type": "network",
            "risk": risk_from_points(points),
            "risk_points": points,
            "indicator": "known_custom_dns_provider",
            "value": {"hits": sorted(set(dns_terms)), "specifier": specifier, "validated_server": validated},
            "reasons": ["Proveedor DNS personalizado detectado; puede ser legitimo, pero debe estar permitido por reglamento"],
        })

    # Valores de resolver alterados rara vez importan para usuarios normales; se registran si hay algo no vacio.
    resolver_keys = [k for k in state.keys() if k.startswith("dns_resolver_") and safe_text(state.get(k))]
    if resolver_keys:
        findings.append({
            "type": "network",
            "risk": "BAJO",
            "risk_points": 4,
            "indicator": "dns_resolver_global_settings_present",
            "value": {k: state.get(k) for k in resolver_keys},
            "reasons": ["Configuraciones globales del resolver DNS presentes. Indicador contextual, no prueba de trampa."],
        })

    for item in findings:
        item.setdefault("category", "dns_modificado")
        item.setdefault("confidence", confidence_from_points(item.get("risk_points", 0)))
        item.setdefault("evidence_level", evidence_level(item.get("risk"), network=True))

    return findings, state


def parse_ports_from_text(text, proxy_ports):
    hits = []
    port_set = {int(p) for p in proxy_ports}
    for line in text.splitlines():
        clean = line.strip()
        for match in re.finditer(r":(\d{1,5})\b", clean):
            try:
                port = int(match.group(1))
            except Exception:
                continue
            if port in port_set:
                hits.append({"port": port, "line": clean[:300]})
    return hits


