    html_path = os.path.join(out_dir, base + ".html")

    with open(json_path, "w", encoding="utf-8") as f:
        json.dump(report, f, indent=2, ensure_ascii=False)
    write_txt_report(report, txt_path)
    generate_html_report(report, html_path)
    return txt_path, json_path, html_path


def print_final(report, txt_path, json_path, html_path):
    clear_screen()
    print_header_small()
    pulse_line("Análisis completado", cycles=1)
    print(f"{DARK_GRAY}Preparando resultados...{RESET}")


def prompt_or_default(label, default=""):
    value = input(label).strip()
    return value if value else default


def run_analysis(args=None, use_adb=False):
    rules = load_rules()
    hours = DEFAULT_HOURS
    player = "dispositivo"
    clear_screen()
    print_header_small()
    title = "INICIAR ANALISIS AVANZADO ADB" if use_adb else "INICIAR ANALISIS NORMAL"
    print(f"{WHITE}{title}{RESET}")
    print(f"{DARK_RED}" + "=" * 62 + f"{RESET}")
    if use_adb:
        print(f"ADB: {adb_status_text()}")
        if not get_adb_connected_devices():
            print(f"{SCARLET}[!] ADB no está conectado.{RESET}")
            print("Usa [0] Emparejar dispositivo y vuelve a iniciar el análisis.\n")

    report = build_report(player, hours, rules, use_adb=use_adb)
    txt_path, json_path, html_path = save_reports(report)
    print_final(report, txt_path, json_path, html_path)

    server, report_url = start_local_report_server(html_path)
    if server:
        print(f"\n{WHITE}VISOR WEB LOCAL{RESET}")
        print(f"{DARK_RED}{'=' * 62}{RESET}")
        print(f"URL : {WHITE}{report_url}{RESET}")
        print("El visor muestra un estado para cada capa, incluso cuando no hay hallazgos.")
        print("La URL funciona solo en este teléfono mientras esta pantalla siga abierta.")
    else:
        print(f"\n{SCARLET}[!] {report_url}{RESET}")
        print(f"Puedes abrir manualmente el HTML: {html_path}")
    try:
        input("\nPresiona Enter para cerrar el visor local y continuar...")
    except EOFError:
        pass
    finally:
        if server:
            server.shutdown(); server.server_close()

def parse_args():
    parser = argparse.ArgumentParser(description="ANDREZN")
    parser.add_argument("--no-menu", action="store_true", help="Ejecutar análisis directamente")
    parser.add_argument("--adb", action="store_true", help="Ejecutar análisis avanzado ADB")
    return parser.parse_args()

def main():
    ensure_dirs()
    animate_boot_sequence()
    args = parse_args()
    if args.no_menu:
        run_analysis(args, use_adb=getattr(args, "adb", False))
        return
    while True:
        action = intro_menu()
        if action == "analysis":
            if not adb_available() or not get_adb_connected_devices():
                clear_screen()
                print_header_small()
                print(f"{SCARLET}[!] Debes emparejar ADB antes de iniciar.{RESET}")
                print("Usa [0] Emparejar dispositivo ADB y luego vuelve a [1].")
                input("\nPresiona Enter para volver al menú...")
                continue
            run_analysis(args=None, use_adb=True)
        elif action == "dump":
            save_adb_dump()
        elif action == "bugreport":
            create_bugreport_manual()
        elif action == "exit":
            clear_screen()
            print(f"{GREEN}Cerrando ANDREZN...{RESET}\n")
            break


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print(f"\n{SCARLET}Cancelado por el usuario.{RESET}")
        sys.exit(130)

