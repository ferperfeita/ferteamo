        "/sdcard/android/media/com.dts.freefiremax",
    ]
    return not any(lower.startswith(x) for x in expected)


def contains_any(text, terms):
    text = safe_text(text).lower()
    hits = []
    for term in terms:
        term = safe_text(term).lower()
        if term and term in text:
            hits.append(term)
    return hits


def add_reason(reasons, points_ref, message, points):
    reasons.append(message)
    points_ref[0] += points


def risk_from_points(points):
    if points >= 24:
        return "CRITICO"
    if points >= 15:
        return "ALTO"
    if points >= 7:
        return "MEDIO"
    if points >= 1:
        return "BAJO"
    return "NINGUNO"


def confidence_from_points(points):
    """Confianza operativa. No es porcentaje forense; sirve para priorizar revision."""
    if points >= 30:
        return "MUY_ALTA"
    if points >= 20:
        return "ALTA"
    if points >= 11:
        return "MEDIA"
    if points >= 5:
        return "BAJA"
    return "MUY_BAJA"


def evidence_level(risk, recent=False, known_hash=False, network=False):
    if known_hash:
        return "fuerte_hash_confirmado"
    if risk in ["CRITICO", "ALTO"] and recent:
        return "fuerte_reciente"
    if risk in ["CRITICO", "ALTO"] and network:
        return "fuerte_red"
    if risk == "MEDIO":
        return "moderado"
    if risk == "BAJO":
        return "debil"
    return "sin_indicador"


def category_from_text(text, reasons=None):
    text = safe_text(text).lower()
    reasons_text = " ".join(reasons or []).lower()
    combined = f"{text} {reasons_text}"
    if any(x in combined for x in ["magisk", "kernelsu", "ksu", "apatch", "zygisk", "susfs", "root", "superuser", "su binary"]):
        return "root_integridad"
    if any(x in combined for x in ["xposed", "lsposed", "edxposed", "riru", "frida", "hook", "hooking", "substrate", "shamiko"]):
        return "hooking_inyeccion"
    if any(x in combined for x in ["adb", "adbkey", "adb_keys", "platform-tools", "debug bridge", "logcat", "scrcpy"]):
        return "adb_depuración"
    if any(x in combined for x in ["unityfs", "shader", "overlay", "replay", "modded", "cracked", "libil2cpp", "global-metadata", "com.dts.freefire"]):
        return "archivos_juego"
    if any(x in combined for x in ["androidgg", "gameguardian", "gamesir", "mantis", "octopus", "keymapper", "mouse mapper", "auto clicker", "autoclicker", "macrodroid", "vmos"]):
        return "herramientas_externas"
    if any(x in combined for x in ["proxy", "vpn", "tunel", "tunnel", "dns", "socks", "v2ray", "clash", "shadowsocks", "packet", "pcap"]):
        return "red_proxy_vpn"
    if any(x in combined for x in ["aimbot", "wallhack", "esp", "modmenu", "magic bullet", "auto headshot", "injector", "bypass", "antiban"]):
        return "cheat_alto_riesgo"
    if any(x in combined for x in ["macro", "regedit", "panel", "script", "loader"]):
        return "macro_script_config"
    if any(x in combined for x in ["gfx", "dpi", "sensi", "config", "cfg", "obb", "patch"]):
        return "configuracion_juego"
    return "general"


def should_report_file(points, ext, recent, keyword_hits, known_hash_hit):
    """Reduce falsos positivos: no reporta un .zip/.txt viejo solo por extension."""
    if known_hash_hit:
        return True
    if keyword_hits:
        return True
    if recent and ext in DEFAULT_RULES.get("critical_extensions", []):
        return True
    if recent and points >= 5:
        return True
    return False


def analyze_file(path, cutoff_time, rules):
    filename = os.path.basename(path)
    lower_path = path.lower()
    lower_name = filename.lower()
    ext = os.path.splitext(lower_name)[1]
    # Multimedia/documentos visuales nunca se elevan por el nombre. Un PNG llamado "aimbot" no es evidencia técnica.
    ignored_media_exts = {
        ".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".heic", ".heif",
        ".mp4", ".mkv", ".avi", ".mov", ".webm", ".3gp", ".mp3", ".wav", ".ogg", ".m4a",
        ".pdf", ".doc", ".docx", ".ppt", ".pptx", ".xls", ".xlsx"
    }
    if ext in ignored_media_exts:
        return None
    modified = file_modified_time(path)
    recent = bool(modified and modified >= cutoff_time)
    size_mb = file_size_mb(path)

    reasons = []
    points = [0]
    keyword_hits = []
    network_hits = []
    known_hash_hit = False

    # APK/ZIP/JAR: revisa estructura interna sin extraer ni ejecutar.
    archive_hits = inspect_archive_indicators(path) if (recent or ext in {".apk", ".apks", ".xapk", ".zip", ".jar"}) else []
    if archive_hits:
        keyword_hits.extend(archive_hits)
        add_reason(reasons, points, "El archivo técnico contiene componentes internos asociados a hooking/modificación.", 12)

    critical_hits = contains_any(lower_path, rules.get("critical_keywords", []))
    for hit in critical_hits:
        keyword_hits.append(hit)
        add_reason(reasons, points, f"Palabra critica detectada: {hit}", 12)

    high_hits = contains_any(lower_path, rules.get("high_keywords", []))
    for hit in high_hits:
        keyword_hits.append(hit)
        add_reason(reasons, points, f"Palabra de alto riesgo detectada: {hit}", 7)

    medium_hits = contains_any(lower_path, rules.get("medium_keywords", []))
    for hit in medium_hits:
        keyword_hits.append(hit)
        add_reason(reasons, points, f"Palabra sensible detectada: {hit}", 2)

    for hit in contains_any(lower_path, rules.get("network_keywords", [])):
        network_hits.append(hit)
        keyword_hits.append(hit)
        add_reason(reasons, points, f"Indicador de red/proxy/VPN detectado: {hit}", 5)

    for hit in contains_any(lower_path, rules.get("root_keywords", [])):
        keyword_hits.append(hit)
        add_reason(reasons, points, f"Indicador root/modulo detectado en archivo/ruta: {hit}", 8)

    for hit in contains_any(lower_path, rules.get("hook_keywords", [])):
        keyword_hits.append(hit)
        add_reason(reasons, points, f"Indicador hooking/inyeccion detectado en archivo/ruta: {hit}", 9)

    for hit in contains_any(lower_path, rules.get("adb_keywords", [])):
        keyword_hits.append(hit)
        add_reason(reasons, points, f"Indicador ADB/depuración detectado en archivo/ruta: {hit}", 5)

    for hit in contains_any(lower_path, rules.get("external_tool_keywords", [])):
        keyword_hits.append(hit)
        add_reason(reasons, points, f"Herramienta externa detectada en archivo/ruta: {hit}", 8)

    game_hits = contains_any(lower_path, rules.get("game_file_keywords", []))
    explicit_game_terms = {"shaderoverlay", "modded", "cracked", "obb mod", "replayinject", "replay injector"}
    material_game_hits = [h for h in game_hits if safe_text(h).lower() in explicit_game_terms]
    for hit in material_game_hits:
        keyword_hits.append(hit)
        add_reason(reasons, points, f"Indicador técnico explícito relacionado con el juego: {hit}", 6)

    # Marcadores de contenido. Se usa lectura parcial para no hacer lento el scanner.
    content_marker_hits = []
    if recent or material_game_hits or any(x in lower_path for x in ["freefire", "garena", "com.dts.freefire", "modded", "replayinject", "shaderoverlay"]):
        head = file_head_text(path, limit=8192)
        for marker in rules.get("game_content_markers", []):
            if safe_text(marker) and safe_text(marker).lower() in head.lower():
                content_marker_hits.append(marker)
        if content_marker_hits:
            keyword_hits.extend(content_marker_hits)
            outside_expected = is_path_outside_expected_game_dirs(path)
            add_reason(
                reasons,
                points,
                f"Marcador interno de archivo del juego detectado: {', '.join(sorted(set(content_marker_hits)))}",
                9 if recent and outside_expected else 4
            )
            if outside_expected:
                add_reason(reasons, points, "Archivo con marcador de juego fuera de carpeta oficial esperada", 5)

    # Extension sola ya no basta si el archivo es viejo; esto mejora precision post-partida.
    if ext in rules.get("critical_extensions", []):
        if recent or keyword_hits:
            add_reason(reasons, points, f"Extension ejecutable/modificable relevante: {ext}", 7 if recent else 3)
    elif ext in rules.get("medium_extensions", []):
        if recent and keyword_hits:
            add_reason(reasons, points, f"Extension revisable con contexto sospechoso: {ext}", 2)

    if recent and keyword_hits:
        add_reason(reasons, points, "Archivo dentro de la ventana post-partida", 8)
    elif recent and ext in rules.get("critical_extensions", []):
        add_reason(reasons, points, "Archivo ejecutable/modificable creado o cambiado recientemente", 6)

    file_hash = None
    if keyword_hits or ext in rules.get("critical_extensions", []) or recent:
        file_hash = sha256_file(path, rules.get("max_file_size_mb_for_hash", 350))
        known = rules.get("known_bad_hashes", {})
        if file_hash and file_hash in known:
            known_hash_hit = True
            add_reason(reasons, points, f"Hash confirmado: {known[file_hash]}", 30)

    if not should_report_file(points[0], ext, recent, keyword_hits, known_hash_hit):
        return None

    risk = risk_from_points(points[0])
    category = category_from_text(lower_path, reasons)

    return {
        "type": "file",
        "risk": risk,
        "risk_points": points[0],
        "confidence": confidence_from_points(points[0]),
        "evidence_level": evidence_level(risk, recent=recent, known_hash=known_hash_hit, network=bool(network_hits)),
        "category": category,
        "filename": filename,
        "path": path,
        "extension": ext,
        "size_mb": size_mb,
        "modified_time": modified.isoformat() if modified else None,
        "recently_modified": recent,
        "sha256": file_hash,
        "keyword_hits": sorted(set(keyword_hits)),
        "reasons": reasons,
    }

def scan_files(cutoff_time, rules):
    findings = []
    scanned = 0
    inaccessible = 0
    dirs = rules.get("scan_dirs", DEFAULT_SCAN_DIRS)

    for base in dirs:
        if not base or not os.path.exists(base) or is_scanner_generated_path(base):
            continue
        print(f"{LIGHT_RED}[*]{RESET} Revisando: {base}")
        try:
            for root, dirnames, filenames in os.walk(base):
                if is_scanner_generated_path(root):
                    dirnames[:] = []
                    continue

                dirnames[:] = [
                    d for d in dirnames
                    if d.lower() not in [".thumbnails", ".cache", "cache", "logs"]
                    and not is_scanner_generated_path(os.path.join(root, d))
                ]

                for filename in filenames:
                    path = os.path.join(root, filename)
                    if is_scanner_generated_path(path):
                        continue

                    scanned += 1
                    result = analyze_file(path, cutoff_time, rules)
                    if result:
                        findings.append(result)
                    if scanned % 700 == 0:
                        print(f"    Archivos revisados: {scanned}")
        except PermissionError:
            inaccessible += 1
        except Exception:
            inaccessible += 1

    return findings, scanned, inaccessible


def get_installed_packages():
    output = run_command(["pm", "list", "packages", "-3"], timeout=12)
    packages = []
    for line in output.splitlines():
        line = line.strip()
        if line.startswith("package:"):
            packages.append(line.replace("package:", ""))
    return sorted(set(packages))


def get_package_details(package):
    if package in PACKAGE_DETAILS_CACHE:
        return PACKAGE_DETAILS_CACHE[package]

    output = run_command(["dumpsys", "package", package], timeout=8)
    details = {
        "first_install_time": None,
        "last_update_time": None,
        "version_name": None,
        "installer": None,
        "code_path": None,
        "uid": None,
    }
    for line in output.splitlines():
        clean = line.strip()
        if clean.startswith("firstInstallTime="):
            details["first_install_time"] = clean.replace("firstInstallTime=", "")
        elif clean.startswith("lastUpdateTime="):
            details["last_update_time"] = clean.replace("lastUpdateTime=", "")
        elif clean.startswith("versionName="):
            details["version_name"] = clean.replace("versionName=", "")
        elif clean.startswith("installerPackageName="):
            details["installer"] = clean.replace("installerPackageName=", "")
        elif clean.startswith("codePath="):
            details["code_path"] = clean.replace("codePath=", "")
        elif clean.startswith("userId="):
            details["uid"] = clean.replace("userId=", "")

    PACKAGE_DETAILS_CACHE[package] = details
    return details


