def _ff_apk_fingerprint_adb(pkg):
    paths_out = adb_shell(f"pm path {shlex.quote(pkg)} 2>/dev/null", timeout=6)
    paths = [ln.split(":", 1)[1].strip() for ln in paths_out.splitlines() if ln.startswith("package:") and ":" in ln]
    if not paths:
        return None
    dump = adb_shell(f"dumpsys package {shlex.quote(pkg)} 2>/dev/null | grep -E 'versionCode=|versionName=' | head -8", timeout=7)
    vm = re.search(r"versionCode=(\d+)", dump)
    vn = re.search(r"versionName=([^\s]+)", dump)
    digests = []
    for p in paths[:12]:
        out = adb_shell(f"sha256sum {shlex.quote(p)} 2>/dev/null | head -1", timeout=10)
        m = re.match(r"([0-9a-fA-F]{64})\s+", out.strip())
        if m:
            digests.append(m.group(1).lower())
    digest = ""
    if digests:
        h = hashlib.sha256()
        for d in sorted(digests):
            h.update(d.encode("ascii"))
        digest = h.hexdigest()
    return {"version_code": vm.group(1) if vm else "", "version_name": vn.group(1) if vn else "", "digest": digest, "parts": len(digests)}


def scan_ff_baseline_definitive_adb(rules):
    status = {"available": False, "packages": {}, "result": "NO_EJECUTADO"}
    findings = []
    if not adb_available() or not get_adb_connected_devices():
        return findings, status
    status["available"] = True
    try:
        baseline = json.loads(Path(ANDREZNSH_BASELINE_PATH).read_text(encoding="utf-8")) if os.path.isfile(ANDREZNSH_BASELINE_PATH) else {}
        if not isinstance(baseline, dict): baseline = {}
    except Exception:
        baseline = {}
    changed = False
    checked = 0
    for pkg in _ff_installed_packages_adb(rules):
        fp = _ff_apk_fingerprint_adb(pkg)
        if not fp:
            continue
        checked += 1
        status["packages"][pkg] = {"version_code": fp.get("version_code"), "parts": fp.get("parts"), "hash_available": bool(fp.get("digest"))}
        if not fp.get("digest"):
            continue
        old = baseline.get(pkg)
        if not old or old.get("version_code") != fp.get("version_code"):
            baseline[pkg] = fp
            changed = True
            continue
        if old.get("digest") and not hmac.compare_digest(safe_text(old.get("digest")), safe_text(fp.get("digest"))):
            findings.append(_make_def_finding(
                "integridad_apk_free_fire", "local_apk_baseline_changed", 20,
                "Los APK/splits de Free Fire cambiaron sin cambiar el versionCode registrado en la línea base local.",
                {"package": pkg, "version_code": fp.get("version_code")}, "integridad_confirmada", "apk_integrity"))
    if changed:
        try:
            os.makedirs(os.path.dirname(ANDREZNSH_BASELINE_PATH), exist_ok=True)
            Path(ANDREZNSH_BASELINE_PATH).write_text(json.dumps(baseline, indent=2, ensure_ascii=False), encoding="utf-8")
            os.chmod(ANDREZNSH_BASELINE_PATH, 0o600)
        except Exception:
            pass
    if not checked:
        status["result"] = "FREE_FIRE_NO_DETECTADO"
    elif findings:
        status["result"] = "CAMBIO_SIN_VERSION_NUEVA"
    elif changed:
        status["result"] = "BASELINE_CREADA_O_ACTUALIZADA"
    else:
        status["result"] = "COINCIDE_CON_BASELINE"
    return findings, status


def inspect_archive_indicators(path, max_members=2500):
    """Inspección estática de nombres internos; no extrae ni ejecuta contenido."""
    ext = os.path.splitext(safe_text(path).lower())[1]
    if ext not in {".apk", ".apks", ".xapk", ".zip", ".jar"}:
        return []
    try:
        if os.path.getsize(path) > 160 * 1024 * 1024 or not zipfile.is_zipfile(path):
            return []
        markers = ["frida-gadget", "libfrida", "gadget.config", "xposedbridge", "libsubstrate", "gameguardian", "androidgg", "lspatch", "npatch", "replayinject", "magicbullet", "wallhack", "aimbot"]
        with zipfile.ZipFile(path, "r") as zf:
            names = "\n".join(info.filename.lower() for info in zf.infolist()[:max_members])
        return sorted({m for m in markers if m in names})
    except Exception:
        return []


def correlate_findings_definitive(findings, rules):
    """Correlación conservadora: gravedad y certeza se separan; contexto aislado no se auto-eleva."""
    items = [dict(x) for x in findings]
    # Coarse families and independent observation sources.
    def family(item):
        cat = safe_text(item.get("category")).lower()
        ind = safe_text(item.get("indicator")).lower()
        if any(x in cat + " " + ind for x in ("hook", "inyeccion", "memoria_juego", "frida", "xposed", "puertos_sospechosos")): return "hooking"
        if "replay" in cat + ind: return "replay"
        if any(x in cat + ind for x in ("control_remoto", "remote")): return "remote"
        if any(x in cat + ind for x in ("root", "integridad")): return "integrity"
        if any(x in cat + ind for x in ("adb", "usb")): return "adb"
        return cat or "general"
    source_groups = {}
    for item in items:
        fam = family(item)
        src = _finding_source_group(item)
        source_groups.setdefault(fam, set()).add(src)
    for item in items:
        fam = family(item)
        groups = sorted(source_groups.get(fam, {_finding_source_group(item)}))
        item["correlation_sources"] = groups
        item["correlation_count"] = len(groups)
        direct = item.get("evidence_level") in ("directo", "integridad_confirmada", "hash_apk_no_coincide", "firma_paquete_no_coincide", "fuerte_hash_confirmado")
        points = int(item.get("risk_points", 0) or 0)
        cat = safe_text(item.get("category"))
        # Isolated environment/network/ADB/file-name signals cannot be high severity.
        if len(groups) <= 1 and not direct:
            if cat in ("root_integridad", "adb_depuración", "red_proxy_vpn", "dns_modificado", "shaders_overlay") or item.get("type") == "file":
                points = min(points, 6)
            elif cat == "hooking_inyeccion" and item.get("indicator") in ("hooking_related_packages", "hooking_path_present"):
                points = min(points, 6)
        item["risk_points"] = points
        item["risk"] = "NINGUNO" if points <= 0 else risk_from_points(points)
        if direct:
            item["confidence"] = "MUY_ALTA"
        elif len(groups) >= 3 and points >= 7:
            item["confidence"] = "ALTA"
        elif len(groups) >= 2:
            item["confidence"] = "MEDIA"
        else:
            item["confidence"] = "BAJA"
    return sorted(items, key=lambda x: (int(x.get("risk_points", 0) or 0), int(x.get("correlation_count", 1) or 1)), reverse=True)

