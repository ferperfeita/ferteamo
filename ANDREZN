def installer_trust_level(installer, rules):
    installer = safe_text(installer)
    if not installer:
        return "desconocido"
    if installer in rules.get("trusted_installers", []):
        return "confiable_o_sistema"
    if "packageinstaller" in installer.lower():
        return "instalador_manual_sistema"
    return "tercero"


def scan_recent_app_changes(cutoff_time, rules):
    """Lista apps instaladas o actualizadas en la ventana post-partida, aunque el nombre no sea sospechoso."""
    findings = []
    packages = get_installed_packages()

    critical_terms = rules.get("package_critical_indicators", [])
    medium_terms = rules.get("package_medium_indicators", [])
