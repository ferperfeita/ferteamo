def _epoch_to_iso(value):
    try:
        return datetime.fromtimestamp(float(value)).isoformat()
    except Exception:
        return None


def _parse_stat_line(line):
    line = safe_text(line)
    if not line or "|" not in line:
        return None
    parts = line.rsplit("|", 3)
    if len(parts) != 4:
        return None
    path, atime, mtime, ctime = parts
    try:
        return {
            "path": path,
            "atime_epoch": float(atime),
            "mtime_epoch": float(mtime),
            "ctime_epoch": float(ctime),
            "atime": _epoch_to_iso(atime),
            "mtime": _epoch_to_iso(mtime),
            "ctime": _epoch_to_iso(ctime),
        }
    except Exception:
        return None


def _package_install_update_times_adb(package):
    dump = adb_shell(
        f"dumpsys package {shlex.quote(package)} | grep -E 'firstInstallTime=|lastUpdateTime='",
        timeout=12,
    )
    return {
        "first_install": parse_time_from_dumpsys(dump, "firstInstallTime"),
        "last_update": parse_time_from_dumpsys(dump, "lastUpdateTime"),
        "raw": dump,
    }


def _discover_replay_paths_adb(package):
    if not re.fullmatch(r"[A-Za-z0-9._]+", safe_text(package)):
        return []
    roots = [
        f"/sdcard/Android/data/{package}/files",
        f"/storage/emulated/0/Android/data/{package}/files",
    ]
    discovered = []
    for root in roots:
        qroot = shlex.quote(root)
        output = adb_shell(
            f"find {qroot} -maxdepth 7 \\( -type d -o -type f \\) "
            f"\\( -iname '*mreplay*' -o -iname '*replay*' \\) -print 2>/dev/null | head -n 40",
            timeout=25,
        )
        discovered.extend(x.strip() for x in output.splitlines() if x.strip())
        for dirname in ["MReplays", "MREPLAYS", "mreplays", "Replays", "replays"]:
            exact = f"{root}/{dirname}"
            exists = adb_shell(f"test -e {shlex.quote(exact)} && echo EXISTS", timeout=6)
            if "EXISTS" in exists:
                discovered.append(exact)
    return sorted(set(discovered))[:40]


def _stat_replay_tree_adb(root_path):
    qroot = shlex.quote(root_path)
    paths_out = adb_shell(
        f"(echo {qroot}; find {qroot} -maxdepth 2 -print 2>/dev/null) | head -n 100",
        timeout=22,
    )
    records = []
    seen = set()
    for path in paths_out.splitlines():
        path = path.strip()
        if not path or path in seen:
            continue
        seen.add(path)
        stat_out = adb_shell(
            f"stat -c '%n|%X|%Y|%Z' {shlex.quote(path)} 2>/dev/null",
            timeout=8,
        )
        for line in stat_out.splitlines():
            parsed = _parse_stat_line(line)
            if parsed:
                records.append(parsed)
    return records


def scan_replay_timestamps_adb(rules, cutoff_time):
    """Replay forense con presupuesto estricto y stat por lotes.

    Evita un round-trip ADB por archivo. Los timestamps son contexto: nunca confirman cheat por sí solos.
    """
    status = {
        "available": False, "packages_checked": [], "replay_paths_found": 0,
        "records_checked": 0, "anomaly_count": 0, "result": "NO_EJECUTADO",
        "limited": False, "elapsed_seconds": 0.0,
    }
    if not adb_available() or not get_adb_connected_devices():
        return [], status
    status["available"] = True
    started = time.monotonic()
    deadline = started + 25.0
    now = datetime.now()
    findings = []
    all_records = []
    roots = []
    installed_packages = []

    for package in rules.get("free_fire_packages", ["com.dts.freefireth", "com.dts.freefiremax"]):
        if time.monotonic() >= deadline:
            status["limited"] = True
            break
        if not re.fullmatch(r"[A-Za-z0-9._]+", safe_text(package)):
            continue
        out = adb_shell(f"pm path {shlex.quote(package)} 2>/dev/null", timeout=3)
        if out.startswith("package:"):
            installed_packages.append(package)
            status["packages_checked"].append(package)

    replay_terms = rules.get("replay_dir_names", ["MReplays", "Replays", "replay"])
    expr = " -o ".join("-iname '*{}*'".format(safe_text(x).replace("'", "")) for x in replay_terms[:8])
    for package in installed_packages:
        for base in (f"/sdcard/Android/data/{package}", f"/sdcard/Android/media/{package}"):
            if len(roots) >= 6 or time.monotonic() >= deadline:
                status["limited"] = True
                break
            remain = max(1, int(deadline - time.monotonic()))
            out = adb_shell(
                f"find {shlex.quote(base)} -maxdepth 7 -type d \\( {expr} \\) -print 2>/dev/null | head -6",
                timeout=min(5, remain),
            )
            for line in out.splitlines():
                p = line.strip()
                if p and p not in roots:
                    roots.append(p)
                if len(roots) >= 6:
                    break

    status["replay_paths_found"] = len(roots)
    for root in roots[:6]:
        if time.monotonic() >= deadline:
            status["limited"] = True
            break
        remain = max(1, int(deadline - time.monotonic()))
        batch = adb_shell(
            "find " + shlex.quote(root) + " -maxdepth 4 -type f "
            "-exec stat -c '%X|%Y|%Z|%s' {} \\; 2>/dev/null | head -80",
            timeout=min(7, remain),
        )
        for line in batch.splitlines():
            parts = line.strip().split("|")
            if len(parts) != 4:
                continue
            try:
                at, mt, ct, sz = (int(float(x)) for x in parts)
            except Exception:
                continue
            all_records.append({"atime_epoch": at, "mtime_epoch": mt, "ctime_epoch": ct, "size": sz})
            if len(all_records) >= 240:
                status["limited"] = True
                break
        if len(all_records) >= 240:
            break

    status["records_checked"] = len(all_records)
    future_items = []
    copied_items = []
    large_gap_items = []
    recent_items = []
    for r in all_records:
        try:
            mdt = datetime.fromtimestamp(r["mtime_epoch"])
            cdt = datetime.fromtimestamp(r["ctime_epoch"])
            adt = datetime.fromtimestamp(r["atime_epoch"])
        except Exception:
            continue
        if mdt >= cutoff_time or cdt >= cutoff_time:
            recent_items.append(r)
        if mdt > now + timedelta(minutes=10) or cdt > now + timedelta(minutes=10):
            future_items.append(r)
        if cdt >= cutoff_time and mdt < cutoff_time - timedelta(hours=2) and (cdt - mdt) > timedelta(hours=6):
            copied_items.append(r)
        if abs((cdt - mdt).total_seconds()) > 7 * 86400:
            large_gap_items.append(r)

    reasons = []
    points = 0
    if future_items:
        points += 10
        reasons.append("Se detectaron fechas de replay incoherentes con el reloj actual.")
    if copied_items:
        points += 8
        reasons.append("Hay metadatos compatibles con archivos de replay copiados/restaurados recientemente.")
    if len(large_gap_items) >= 3:
        points += 3
        reasons.append("Varios replays presentan diferencias temporales grandes entre modificación y cambio de metadatos.")
    points = min(points, 16)

    if points:
        status["anomaly_count"] = 1
        findings.append({
            "type": "replay", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "MEDIA", "evidence_level": "moderado_timestamps",
            "category": "replay_integridad", "indicator": "replay_timestamp_anomaly",
            "value": {"records_checked": len(all_records), "future": len(future_items),
                      "copied_recently": len(copied_items), "large_time_gaps": len(large_gap_items),
                      "limited": status["limited"]},
            "reasons": reasons + ["Los timestamps por sí solos no prueban un pasador de replay."],
        })
    elif all_records:
        findings.append({
            "type": "replay", "risk": "NINGUNO", "risk_points": 0, "confidence": "ALTA",
            "evidence_level": "contexto_sin_anomalia", "category": "replay_integridad",
            "indicator": "replay_timestamps_no_material_anomaly",
            "value": {"records_checked": len(all_records), "recent": len(recent_items), "limited": status["limited"]},
            "reasons": ["Se revisaron replays accesibles y no se encontró una anomalía temporal material."],
        })

    if not installed_packages:
        status["result"] = "FREE_FIRE_NO_DETECTADO"
    elif not roots:
        status["result"] = "SIN_RUTA_REPLAY_ACCESIBLE"
    elif status["anomaly_count"]:
        status["result"] = "ANOMALIA_CONTEXTUAL"
    else:
        status["result"] = "SIN_ANOMALIA_MATERIAL"
    status["elapsed_seconds"] = round(time.monotonic() - started, 2)
    return findings, status

def _adb_path_records(paths, limit=100):
    """Obtiene stat de rutas ADB sin modificar archivos."""
    records = []
    seen = set()
    for path in paths[:limit]:
        path = safe_text(path).strip()
        if not path or path in seen:
            continue
        seen.add(path)
        stat_out = adb_shell(
            f"stat -c '%n|%X|%Y|%Z' {shlex.quote(path)} 2>/dev/null",
            timeout=8,
        )
        for line in stat_out.splitlines():
            parsed = _parse_stat_line(line)
            if parsed:
                records.append(parsed)
    return records


