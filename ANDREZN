def _parse_package_list(output):
    packages = set()
    for line in safe_text(output).splitlines():
        matches = re.findall(r"(?:package:)?(?:[^=\s]+\.apk=)?(com\.[A-Za-z0-9._]+|org\.[A-Za-z0-9._]+|io\.[A-Za-z0-9._]+|net\.[A-Za-z0-9._]+)", line)
        packages.update(matches)
    return packages


def scan_android_special_access_adb(rules):
    """Revisa accesibilidad, overlay, instalación de APK, VPN, perfiles y restos de paquetes."""
    status = {"available": False, "accessibility": [], "notification_listeners": [], "overlay_allowed": [], "install_packages_allowed": [], "removed_suspicious_packages": [], "profiles": [], "result": "NO_EJECUTADO"}
    if not adb_available() or not get_adb_connected_devices():
        return [], status
    status["available"] = True
    findings = []
    terms = rules.get("special_access_package_terms", []) + rules.get("remote_control_package_indicators", [])

    accessibility = adb_shell("settings get secure enabled_accessibility_services", timeout=8)
    listeners = adb_shell("settings get secure enabled_notification_listeners", timeout=8)
    status["accessibility"] = [x for x in re.split(r"[:,]", accessibility) if "." in x][:30]
    status["notification_listeners"] = [x for x in re.split(r"[:,]", listeners) if "." in x][:30]

    overlay = adb_shell("cmd appops query-op SYSTEM_ALERT_WINDOW allow 2>/dev/null", timeout=15)
    install = adb_shell("cmd appops query-op REQUEST_INSTALL_PACKAGES allow 2>/dev/null", timeout=15)
    status["overlay_allowed"] = sorted(_parse_package_list(overlay))[:50]
    status["install_packages_allowed"] = sorted(_parse_package_list(install))[:50]
    status["profiles"] = [x.strip() for x in adb_shell("pm list users", timeout=10).splitlines() if "UserInfo" in x][:20]
    status["battery_whitelist"] = [x.strip() for x in adb_shell("cmd deviceidle whitelist 2>/dev/null", timeout=12).splitlines() if "." in x][:50]
    status["device_admin_lines"] = [x.strip() for x in adb_shell("dumpsys device_policy", timeout=18).splitlines() if any(k in x.lower() for k in ["admin", "owner", "profile"] )][:40]
    connectivity = adb_shell("dumpsys connectivity", timeout=20)
    status["vpn_lines"] = [x.strip() for x in connectivity.splitlines() if any(k in x.lower() for k in ["vpn", "tun", "wireguard"] )][:40]
    usage = adb_shell("dumpsys usagestats 2>/dev/null", timeout=30)
    usage_lines = []
    for raw in usage.splitlines():
        lower = raw.lower()
        if any(pkg in lower for pkg in rules.get("free_fire_packages", [])) or contains_any(lower, terms):
            usage_lines.append(raw.strip()[:500])
    status["usage_timeline_samples"] = usage_lines[:60]

    current = _parse_package_list(adb_shell("pm list packages", timeout=15))
    with_uninstalled = _parse_package_list(adb_shell("pm list packages -u", timeout=18))
    removed = sorted(with_uninstalled - current)
    suspicious_removed = [pkg for pkg in removed if contains_any(pkg.lower(), terms)]
    status["removed_suspicious_packages"] = suspicious_removed[:40]

    combined_access = sorted(set(status["accessibility"] + status["overlay_allowed"] + status["install_packages_allowed"]))
    suspicious_access = []
    for value in combined_access:
        hits = sorted(set(contains_any(value.lower(), terms)))
        if hits:
            suspicious_access.append({"package_or_service": value, "hits": hits})
    if suspicious_access:
        points = 14
        findings.append({
            "type": "special_access", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "MEDIA", "evidence_level": "permiso_especial_activo",
            "category": "accesos_especiales", "indicator": "suspicious_app_with_special_access",
            "value": suspicious_access[:25],
            "reasons": ["Una aplicación sensible conserva accesibilidad, superposición o permiso para instalar paquetes."],
            "source_group": "special_access"
        })
    if suspicious_removed:
        points = 10
        findings.append({
            "type": "package_history", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "MEDIA", "evidence_level": "paquete_desinstalado_registrado",
            "category": "historial_paquetes", "indicator": "suspicious_uninstalled_package_record",
            "value": suspicious_removed[:30],
            "reasons": ["Package Manager conserva registros de paquetes sensibles que ya no aparecen instalados."],
            "source_group": "package_history"
        })
    suspicious_usage = [line for line in status.get("usage_timeline_samples", []) if contains_any(line.lower(), terms)]
    if suspicious_usage:
        points = 12
        findings.append({
            "type": "usage_timeline", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "MEDIA", "evidence_level": "actividad_registrada_usagestats",
            "category": "actividad_apps", "indicator": "suspicious_app_usage_record",
            "value": suspicious_usage[:25],
            "reasons": ["UsageStats conserva actividad de una aplicación sensible; correlacionar con hora de partida y otras fuentes."],
            "source_group": "usage"
        })
    status["result"] = "COMPLETADO"
    return findings, status


def scan_bugreport_archive(zip_path, rules):
    """Analiza un BugReport ya generado sin extraer datos privados innecesarios al reporte."""
    status = {"available": False, "path": zip_path, "files_read": 0, "bytes_read": 0, "matches": 0, "result": "NO_EJECUTADO"}
    if not zip_path or not os.path.isfile(zip_path) or not zipfile.is_zipfile(zip_path):
        return [], status
    status["available"] = True
    findings = []
    terms = sorted(set(
        rules.get("suspicious_log_keywords", [])
        + rules.get("suspicious_process_keywords", [])
        + rules.get("special_access_package_terms", [])
        + rules.get("remote_control_package_indicators", [])
    ))
    strong = ["frida", "gameguardian", "androidgg", "xposed", "lsposed", "zygisk", "magisk", "kernelsu", "apatch", "wallhack", "aimbot", "modmenu"]
    matches = []
    max_total = 45 * 1024 * 1024
    try:
        with zipfile.ZipFile(zip_path) as zf:
            names = [n for n in zf.namelist() if n.lower().endswith((".txt", ".log", ".xml"))]
            names.sort(key=lambda n: (0 if "dumpstate" in n.lower() else 1, len(n)))
            for name in names[:40]:
                if status["bytes_read"] >= max_total:
                    break
                info = zf.getinfo(name)
                read_size = min(info.file_size, 12 * 1024 * 1024, max_total - status["bytes_read"])
                with zf.open(name) as fh:
                    data = fh.read(read_size)
                status["files_read"] += 1
                status["bytes_read"] += len(data)
                text = data.decode("utf-8", errors="ignore")
                for raw in text.splitlines():
                    lower = raw.lower()
                    hits = sorted(set(contains_any(lower, terms)))
                    if hits and not contains_any(lower, rules.get("benign_log_terms", [])):
                        matches.append({"file": name, "hits": hits[:8], "line": raw.strip()[:500]})
                        if len(matches) >= 80:
                            break
                if len(matches) >= 80:
                    break
    except Exception as exc:
        status["result"] = f"ERROR: {exc}"
        return [], status
    status["matches"] = len(matches)
    if matches:
        joined = " ".join(x["line"].lower() for x in matches)
        points = 20 if any(x in joined for x in strong) else 9
        findings.append({
            "type": "bugreport", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "ALTA" if points >= 15 else "MEDIA", "evidence_level": "bugreport_multifuente",
            "category": "bugreport_android", "indicator": "suspicious_bugreport_evidence",
            "value": matches[:30],
            "reasons": ["El BugReport contiene registros coincidentes con indicadores sensibles."],
            "source_group": "bugreport"
        })
    status["result"] = "COMPLETADO"
    return findings, status


def _finding_source_group(item):
    if item.get("source_group"):
        return item["source_group"]
    category = safe_text(item.get("category")).lower()
    item_type = safe_text(item.get("type")).lower()
    if "logcat" in category or item_type == "live_event": return "logcat"
    if "proceso" in category or item_type == "process_delta": return "process"
    if "puerto" in category: return "port"
    if item_type in ("package", "app_change", "package_history"): return "package"
    if item_type in ("file", "game_file", "replay", "game_context"): return "game_file"
    if item_type == "bugreport": return "bugreport"
    if "hook" in category or "root" in category: return "integrity"
    if item_type == "network": return "network"
    return item_type or "other"


def _finding_tokens(item):
    text = " ".join([
        safe_text(item.get("category")), safe_text(item.get("indicator")), safe_text(item.get("package")),
        safe_text(item.get("path")), safe_text(item.get("filename")), safe_text(item.get("keyword_hits")),
        safe_text(item.get("value")), safe_text(item.get("reasons"))
    ]).lower()
    terms = [
        "frida", "xposed", "lsposed", "gameguardian", "androidgg", "magisk",
        "kernelsu", "apatch", "zygisk", "wallhack", "aimbot", "modmenu",
        "bypass", "antiban", "freefire", "mreplay", "shader", "overlay",
        "anydesk", "teamviewer", "quicksupport", "rustdesk", "airdroid",
        "airmirror", "vysor", "mobizen", "apowermirror", "splashtop",
        "supremo", "zohoassist", "awesun", "droidvnc", "remotepc",
        "spacedesk", "deskdock", "monect", "scrcpy",
    ]
    tokens = {term for term in terms if term in text}
    tokens.update(re.findall(r"\b(?:com|org|net|io|app|de|tv|jp)\.[a-z0-9_]+(?:\.[a-z0-9_]+)*\b", text))
    tokens.update("uid:" + value for value in re.findall(r"\buid\D{0,5}(\d{4,})\b", text))
    return tokens



def evaluate_rule_engine(findings, rules):
    """Aplica reglas regex y reglas lógicas AND/OR configurables en rules.json."""
    output = [dict(item) for item in findings]
    for item in output:
        text = " ".join([
            safe_text(item.get("path")), safe_text(item.get("filename")), safe_text(item.get("package")),
            safe_text(item.get("indicator")), safe_text(item.get("value")), safe_text(item.get("reasons"))
        ])
        applied = []
        for rule in rules.get("regex_rules", []):
            pattern = safe_text(rule.get("pattern"))
            exclude = safe_text(rule.get("exclude"))
            if not pattern:
                continue
            try:
                if exclude and re.search(exclude, text):
                    continue
                if re.search(pattern, text):
                    bonus = int(rule.get("points", 0))
                    item["risk_points"] = int(item.get("risk_points", 0)) + bonus
                    item["risk"] = risk_from_points(item["risk_points"])
                    applied.append(rule.get("id", "regex_rule"))
            except re.error:
                continue
        if applied:
            item.setdefault("reasons", []).append("Reglas regex aplicadas: " + ", ".join(applied))
            item["rule_matches"] = applied

    categories = {safe_text(x.get("category")) for x in output if x.get("risk") != "NINGUNO"}
    for rule in rules.get("advanced_rules", []):
        all_categories = set(rule.get("all_categories", []))
        any_categories = set(rule.get("any_categories", []))
        if all_categories and not all_categories.issubset(categories):
            continue
        if any_categories and not any_categories.intersection(categories):
            continue
        matched = sorted((all_categories | any_categories).intersection(categories))
        if not matched:
            continue
        points = 14 + int(rule.get("bonus", 0))
        output.append({
            "type": "correlation", "risk": risk_from_points(points), "risk_points": points,
            "confidence": "ALTA", "evidence_level": "regla_logica_multifuente",
            "category": "correlacion_evidencias", "indicator": safe_text(rule.get("id", "logical_rule")),
            "value": matched, "reasons": ["Se cumplió una regla lógica con fuentes independientes: " + ", ".join(matched)],
            "source_group": "correlation"
        })
    return output


def correlate_findings(findings, rules):
    """Separa gravedad de confianza y exige fuentes independientes para conclusiones fuertes."""
    enriched = []
    for item in findings:
        item = dict(item)
        item["source_group"] = _finding_source_group(item)
        item["correlation_sources"] = [item["source_group"]]
        item["correlation_count"] = 1
        enriched.append(item)
    for item in enriched:
        tokens = _finding_tokens(item)
        groups = {item["source_group"]}
        for other in enriched:
            if other is item or other.get("risk") == "NINGUNO":
                continue
            if tokens and tokens.intersection(_finding_tokens(other)):
                groups.add(other["source_group"])
        item["correlation_sources"] = sorted(groups)
        item["correlation_count"] = len(groups)
        direct = item.get("evidence_level") in ("hash_apk_no_coincide", "firma_paquete_no_coincide", "fuerte_hash_confirmado")
        if direct:
            item["confidence"] = "MUY_ALTA"
        elif len(groups) >= 3:
            item["confidence"] = "ALTA"
        elif len(groups) == 2:
            item["confidence"] = "MEDIA"
        else:
            item["confidence"] = "BAJA" if item.get("risk_points", 0) < 20 else "MEDIA"
        # Red/VPN/ADB aislados son contexto, no prueba de cheat.
        if item["source_group"] == "network" and len(groups) == 1 and item.get("category") not in ("puertos_delta",):
            item["risk_points"] = min(int(item.get("risk_points", 0)), 6)
            item["risk"] = risk_from_points(item["risk_points"])
            item["evidence_level"] = "contexto_red_sin_correlacion"
    return sorted(enriched, key=lambda x: (x.get("risk_points", 0), x.get("correlation_count", 1)), reverse=True)


def build_timeline(findings):
    timeline = []
    fields = [("modified_time", "archivo_modificado"), ("first_install_time", "app_instalada"), ("last_update_time", "app_actualizada")]
    for item in findings:
        for field, event in fields:
            value = item.get(field)
            if value:
                timeline.append({"time": value, "event": event, "category": item.get("category"), "subject": item.get("path") or item.get("package") or item.get("filename")})
    timeline.sort(key=lambda x: safe_text(x.get("time")), reverse=True)
    return timeline[:80]


def concise_conclusion(report):
    summary = report.get("summary", {})
    verdict_value = summary.get("verdict", "SIN_INDICADORES")
    correlated = summary.get("correlated_findings", 0)
    retained = summary.get("postmatch_logcat_events", 0)
    if verdict_value == "REVISION_URGENTE":
        return f"Se encontraron evidencias fuertes o correlacionadas. Hallazgos correlacionados: {correlated}. Eventos relevantes: {retained}."
    if verdict_value == "REVISION_MANUAL":
        return f"Hay señales relevantes que requieren revisión humana. Hallazgos correlacionados: {correlated}; rastros relevantes de logcat: {retained}."
    if verdict_value == "OBSERVAR":
        return "Solo se encontraron señales débiles o aisladas. No bastan por sí solas para confirmar una inyección o trampa."
    return "No se detectaron indicadores materiales."


def _ensure_signing_key():
    env_key = os.environ.get("ANDREZNSH_SIGNING_KEY", "")
    if env_key:
        return env_key.encode("utf-8"), "environment"
    ensure_dirs()
    try:
        if os.path.isfile(INTEGRITY_KEY_PATH):
            return Path(INTEGRITY_KEY_PATH).read_bytes().strip(), "local"
        key = os.urandom(32).hex().encode("ascii")
        Path(INTEGRITY_KEY_PATH).write_bytes(key)
        try:
            os.chmod(INTEGRITY_KEY_PATH, 0o600)
        except Exception:
            pass
        return key, "local"
    except Exception:
        return b"andreznss-fallback-local-key", "fallback"


def attach_report_integrity(report):
    payload = copy.deepcopy(report)
    payload.pop("integrity", None)
    canonical = json.dumps(payload, sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    key, source = _ensure_signing_key()
    try:
        scanner_hash = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    except Exception:
        scanner_hash = None
    try:
        rules_hash = hashlib.sha256(Path(RULES_PATH).read_bytes()).hexdigest()
    except Exception:
        rules_hash = None
    report["integrity"] = {
        "report_id": str(uuid.uuid4()), "signed_at": datetime.now().isoformat(),
        "hmac_sha256": hmac.new(key, canonical, hashlib.sha256).hexdigest(),
        "key_source": source, "scanner_sha256": scanner_hash, "rules_sha256": rules_hash,
        "scope": "Detección de cambios locales; no es firma forense si el usuario controla Termux."
    }
    return report


def classify_package_category(package, hits):
    package = safe_text(package).lower()
    joined = " ".join(hits).lower()
    if any(x in package or x in joined for x in ["magisk", "ksu", "apatch", "root", "superuser", "zygisk"]):
        return "root_integridad"
    if any(x in package or x in joined for x in ["frida", "xposed", "lsposed", "riru", "hook"]):
        return "hooking_inyeccion"
    if any(x in package or x in joined for x in ["proxy", "vpn", "v2ray", "clash", "tunnel", "dns", "pcap", "canary"]):
        return "red_proxy_vpn"
    if any(x in package or x in joined for x in ["macro", "gamesir", "gameguardian", "androidgg", "keymapper", "mouse", "autoclicker"]):
        return "herramientas_externas"
    return "paquetes_sospechosos"


_SCAN_ANIMATION_STOP = None
_SCAN_ANIMATION_THREAD = None


def progress_bar(current, total, width=24):
    current = max(0, min(current, total))
    filled = int(width * current / max(1, total))
    return "█" * filled + "░" * (width - filled)


def _stop_scan_animation():
    global _SCAN_ANIMATION_STOP, _SCAN_ANIMATION_THREAD
    if _SCAN_ANIMATION_STOP is not None:
        _SCAN_ANIMATION_STOP.set()
    if _SCAN_ANIMATION_THREAD is not None and _SCAN_ANIMATION_THREAD.is_alive():
        _SCAN_ANIMATION_THREAD.join(timeout=0.35)
    _SCAN_ANIMATION_STOP = None
    _SCAN_ANIMATION_THREAD = None
    if sys.stdout.isatty():
        print("\r\033[2K", end="", flush=True)


def print_scan_progress(current, total, text, done=False):
    global _SCAN_ANIMATION_STOP, _SCAN_ANIMATION_THREAD
    percent = int((current / max(1, total)) * 100)
    columns = max(44, shutil.get_terminal_size((72, 20)).columns)
    width = max(8, min(18, columns - 46))
    label_limit = max(12, columns - width - 25)
    label = safe_text(text)
    if len(label) > label_limit:
        label = label[:max(9, label_limit - 3)] + "..."

    if done:
        _stop_scan_animation()
        bar = progress_bar(current, total, width)
        print(f"{GREEN}✓{RESET} [{BRIGHT_RED}{bar}{RESET}] {percent:>3}% {current}/{total} {WHITE}{label}{RESET}")
        return

    _stop_scan_animation()
    if not sys.stdout.isatty():
        bar = progress_bar(current, total, width)
        print(f"{LIGHT_RED}➤{RESET} [{BRIGHT_RED}{bar}{RESET}] {percent:>3}% {current}/{total} {label}")
        return

    stop_event = threading.Event()
    _SCAN_ANIMATION_STOP = stop_event

    def animate():
        frames = ("◢", "◣", "◤", "◥")
        base = int(width * current / max(1, total))
        tick = 0
        while not stop_event.is_set():
            cells = ["░"] * width
            for i in range(min(base, width)):
                cells[i] = "█"
            cursor = min(width - 1, (base + tick) % width)
            cells[cursor] = "▓"
            bar = "".join(cells)
            frame = frames[tick % len(frames)]
            print(
                f"\r\033[2K{LIGHT_RED}{frame}{RESET} "
                f"[{DARK_RED}{bar}{RESET}] {percent:>3}% {current}/{total} "
                f"{WHITE}{label}{RESET}",
                end="",
                flush=True,
            )
            tick += 1
            stop_event.wait(0.10)

    _SCAN_ANIMATION_THREAD = threading.Thread(target=animate, daemon=True)
    _SCAN_ANIMATION_THREAD.start()


def write_dump_file(base_dir, filename, content):
    path = os.path.join(base_dir, filename)
    with open(path, "w", encoding="utf-8", errors="ignore") as f:
        f.write(safe_text(content))
        if not safe_text(content).endswith("\n"):
            f.write("\n")
    return path


