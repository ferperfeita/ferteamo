def package_list():
    out = adb_shell("pm list packages -3 -i 2>/dev/null", timeout=20)
    result = []
    for line in out.splitlines():
        m = re.search(r"package:([^\s]+)(?:\s+installer=([^\s]+))?", line)
        if m:
            result.append({"package": m.group(1), "installer": m.group(2) or ""})
    return result


def process_list():
