def signing_key():
    ensure_dirs()
    if os.path.isfile(KEY_PATH):
        try:
            return Path(KEY_PATH).read_bytes().strip()
        except Exception:
            pass
    key = os.urandom(32).hex().encode("ascii")
    try:
        Path(KEY_PATH).write_bytes(key)
        os.chmod(KEY_PATH, 0o600)
    except Exception:
        pass
    return key


def attach_integrity(report):
    body = json.dumps(report, sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    report["integrity"] = {
        "report_id": str(uuid.uuid4()),
        "signed_at": now_iso(),
        "hmac_sha256": hmac.new(signing_key(), body, hashlib.sha256).hexdigest(),
    }
    return report


def verify_report_file(path):
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
        integrity = data.pop("integrity", {})
        expected = integrity.get("hmac_sha256", "")
        body = json.dumps(data, sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        actual = hmac.new(signing_key(), body, hashlib.sha256).hexdigest()
        return hmac.compare_digest(expected, actual)
    except Exception:
        return False


