def device_apk_fingerprint(pkg):
    paths_out = adb_shell(f"pm path {shlex.quote(pkg)} 2>/dev/null", timeout=8)
    paths=[ln.split(':',1)[1].strip() for ln in paths_out.splitlines() if ln.startswith('package:') and ':' in ln]
    if not paths:
        return None
    dump=adb_shell(f"dumpsys package {shlex.quote(pkg)} 2>/dev/null", timeout=10)
    vm=re.search(r"versionCode=(\d+)", dump)
    vn=re.search(r"versionName=([^\s]+)", dump)
    hashes=[]
    for p in paths:
        out=adb_shell(f"sha256sum {shlex.quote(p)} 2>/dev/null | head -1", timeout=15)
        m=re.match(r"([0-9a-fA-F]{64})\s+", out.strip())
        if m:
            hashes.append((p, m.group(1).lower()))
    if not hashes:
        return {"version_code": vm.group(1) if vm else "", "version_name": vn.group(1) if vn else "", "digest": "", "parts": 0}
    h=hashlib.sha256()
    for _, digest in sorted(hashes): h.update(digest.encode('ascii'))
    return {"version_code": vm.group(1) if vm else "", "version_name": vn.group(1) if vn else "", "digest": h.hexdigest(), "parts": len(hashes)}


def scan_ff_baseline(rules):
    baseline=load_baseline(); changed=False; findings=[]; stats={}
    for pkg in rules["free_fire_packages"]:
        fp=device_apk_fingerprint(pkg)
        if not fp: continue
        stats[pkg] = {"version_code": fp.get("version_code"), "parts": fp.get("parts"), "hash_available": bool(fp.get("digest"))}
        if not fp.get("digest"): continue
        old=baseline.get(pkg)
        if not old or old.get("version_code") != fp.get("version_code"):
            baseline[pkg]=fp; changed=True
            continue
        if old.get("digest") and not hmac.compare_digest(old["digest"], fp["digest"]):
            findings.append(finding(
                "integridad_ff", "Free Fire cambió respecto a su línea base local", "REVISAR", "ALTA", "ALTA",
                "Los APK instalados cambiaron sin cambiar el versionCode registrado. Puede indicar reparación/modificación y requiere revisión manual.",
                source="apk_hash", anchor=pkg, points=14,
                technical={"paquete": pkg, "version_code": fp.get("version_code"), "baseline_local": True}
            ))
    if changed: save_baseline(baseline)
    return findings, stats

def correlate(findings):
    """Evidence fusion: same technical family + independent sources. Context cannot bootstrap itself into a conviction."""
    by_key=defaultdict(list)
    for f in findings:
        if f.get("points",0) <= 0: continue
        by_key[(f.get("category"), f.get("anchor") or "")].append(f)
    for (category, anchor), group in by_key.items():
        sources={g.get("source") for g in group if g.get("source")}
        if len(sources) < 2: continue
        if anchor in {"", "internet", "adb", "environment", "selinux", "rwx", "virtualization"}: continue
        # Root/integrity signals remain environmental even if multiple checks agree.
        if category == "integridad":
            for g in group:
                g["confidence"]="ALTA"; g["correlated_sources"]=sorted(sources)
            continue
        boost = 4 if len(sources)==2 else 7
        for g in group:
            g["points"] += boost
            g["confidence"]="ALTA"
            g["correlated_sources"]=sorted(sources)
            if category == "inyeccion" and (g.get("direct") or len(sources)>=3):
                g["verdict"]="CORRELACIONADO"; g["severity"]="ALTA"
            elif category in {"control_remoto", "automatizacion"} and len(sources)>=2:
                g["verdict"]="CORRELACIONADO"
    return findings

def dedupe_and_simplify(findings):
    # No se muestran hallazgos triviales, duplicados ni contexto de Internet común.
    best = {}
    for f in findings:
        if f.get("category") == "red" and f.get("points", 0) <= 0:
            continue
        key = (f.get("category"), f.get("title"), f.get("anchor"))
        prev = best.get(key)
        if prev is None or f.get("points", 0) > prev.get("points", 0):
            best[key] = f
    items = list(best.values())
    items.sort(key=lambda x: (x.get("points", 0), x.get("confidence") == "ALTA", x.get("direct")), reverse=True)
    return items


def overall_verdict(findings):
    actionable=[f for f in findings if f.get("points",0)>0]
    if not actionable: return "SIN INDICIOS RELEVANTES","No se detectaron señales materiales en la evidencia accesible."
    injection=[f for f in actionable if f.get("category")=="inyeccion" and f.get("points",0)>=16 and (f.get("direct") or len(f.get("correlated_sources",[]))>=2)]
    if injection: return "RIESGO ALTO","Hay evidencia dentro del juego o varias fuentes independientes coinciden en una actividad de hooking/inyección."
    strong=[f for f in actionable if ((f.get("category") in {"memoria","integridad_ff"} and f.get("points",0)>=12) or (f.get("category")=="replay" and f.get("points",0)>=10) or (f.get("category") in {"control_remoto","automatizacion"} and f.get("points",0)>=12 and len(f.get("correlated_sources",[]))>=2) or (f.get("category")=="archivo" and f.get("points",0)>=13))]
    if strong: return "REVISIÓN MANUAL","Hay evidencia técnica material, pero no es suficiente por sí sola para afirmar cheat."
    return "INDICIOS DÉBILES","Solo hay señales aisladas o de contexto. No deben tratarse como confirmación de cheat."
def progress(step, total, label):
    width = 24
    filled = int(width * step / max(1, total))
    bar = "█" * filled + "░" * (width - filled)
    pct = int(100 * step / max(1, total))
    print(f"\r{WHITE}[{bar}] {pct:3d}%{RESET} {GRAY}{label:<32}{RESET}", end="", flush=True)
    if step >= total:
        print()


