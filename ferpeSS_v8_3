def run(cmd, timeout=12):
    try:
        p = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout, check=False)
        return p.stdout.strip()
    except Exception:
        return ""


def adb_available():
    return shutil.which("adb") is not None


def adb(args, timeout=15):
    if not adb_available():
        return ""
    return run(["adb"] + list(args), timeout=timeout)


def adb_shell(command, timeout=15):
    if isinstance(command, str):
        return adb(["shell", "sh", "-c", command], timeout=timeout)
    return adb(["shell"] + list(command), timeout=timeout)


def connected_devices():
    out = adb(["devices"], timeout=8)
    rows = []
    for line in out.splitlines():
        line = line.strip()
        if not line or line.lower().startswith("list of devices"):
            continue
        parts = line.split()
        if len(parts) >= 2:
            rows.append((parts[0], parts[1]))
    return rows


def has_device():
    return any(state == "device" for _, state in connected_devices())


def normalize_adb_addr(value, default_host="127.0.0.1"):
    """Flujo histórico: permite IP:PUERTO o solo PUERTO."""
    value = str(value or "").replace(" ", "")
    if not value:
        return ""
    if ":" in value:
        return value
    if value.isdigit():
        return f"{default_host}:{value}"
    return value


def adb_output_visible(args=None, timeout=20):
    """Equivalente al helper histórico: devuelve stdout+stderr de ADB."""
    if args is None:
        args = []
    if not adb_available():
        return "ADB no esta instalado. Instala android-tools."
    return run(["adb"] + list(args), timeout=timeout)


def _adb_result(args, timeout=20):
    """Ejecuta ADB conservando código de salida y mensaje real para diagnóstico."""
    if not adb_available():
        return 127, "ADB no está instalado. Ejecuta: pkg install android-tools -y"
    try:
        p = subprocess.run(
            ["adb"] + list(args),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
        )
        return p.returncode, (p.stdout or "").strip()
    except subprocess.TimeoutExpired:
        return 124, "ADB agotó el tiempo de espera."
    except Exception as exc:
        return 126, f"No se pudo ejecutar ADB: {exc}"


def _split_endpoint(value):
    value = normalize(value).replace(" ", "")
    if value.startswith("[") and "]:" in value:
        host, port = value.rsplit(":", 1)
        return host, port if port.isdigit() else ""
    if ":" not in value:
        return "", ""
    host, port = value.rsplit(":", 1)
    if not host or not port.isdigit():
        return "", ""
    try:
        p = int(port)
        if not 1 <= p <= 65535:
            return "", ""
    except ValueError:
        return "", ""
    return host, port


def _loopback_endpoint(endpoint):
    host, port = _split_endpoint(endpoint)
    if not port:
        return ""
    if host in ("127.0.0.1", "localhost", "::1", "[::1]"):
        return ""
    return f"127.0.0.1:{port}"


