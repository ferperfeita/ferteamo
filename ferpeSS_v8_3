def is_ignored_file(path, rules):
    low = path.lower().replace("\\", "/")
    if any(term in low for term in rules["ignored_dir_terms"]):
        return True
    return Path(low).suffix in MEDIA_EXTENSIONS


def local_scan_dirs(rules):
    candidates = []
    for path in rules["scan_dirs"]:
        if path.startswith("/sdcard/"):
            rel = path[len("/sdcard/"):]
            mounted = os.path.join(HOME, "storage", "shared", rel)
            if os.path.exists(mounted):
                candidates.append(mounted)
        if os.path.exists(path):
            candidates.append(path)
    seen = []
    for p in candidates:
        if p not in seen:
            seen.append(p)
    return seen


def inspect_local_candidate(path, rules):
    """Static review only. Media is intentionally excluded before this function is called."""
    result = {"archive_hits": [], "content_hits": [], "readable": False}
    ext = Path(path).suffix.lower()
    strong = [x.lower() for x in rules["strong_archive_terms"]]
    try:
        if ext in {".apk", ".zip", ".xapk", ".apks", ".jar"} and zipfile.is_zipfile(path):
            result["readable"] = True
            with zipfile.ZipFile(path) as z:
                names = z.namelist()[:5000]
                for n in names:
                    low = n.lower()
                    term = next((t for t in strong if t in low), None)
                    if term:
                        result["archive_hits"].append(term)
                        if len(result["archive_hits"]) >= 12:
                            break
        elif ext in {".json", ".xml", ".cfg", ".conf", ".ini", ".lua", ".sh", ".py", ".js"}:
            if os.path.getsize(path) <= 4 * 1024 * 1024:
                result["readable"] = True
                raw = Path(path).read_bytes()[:4 * 1024 * 1024]
                text = raw.decode("utf-8", errors="ignore").lower()
                for term in strong:
                    if term in text:
                        result["content_hits"].append(term)
    except Exception:
        pass
    result["archive_hits"] = sorted(set(result["archive_hits"]))
    result["content_hits"] = sorted(set(result["content_hits"]))
    return result


def scan_local_files(rules, cutoff):
    findings = []
    scanned = 0
    strong_names = rules["explicit_cheat_terms"] + ["frida-server", "re.frida.server", "gameguardian", "androidgg"]
    ff_terms = [p.lower() for p in rules["free_fire_packages"]]
    for base in local_scan_dirs(rules):
        for root, dirs, files in os.walk(base):
            lowroot = root.lower().replace("\\", "/")
            dirs[:] = [d for d in dirs if not any(x in (lowroot + "/" + d.lower()) for x in rules["ignored_dir_terms"])]
            for name in files:
                path = os.path.join(root, name)
                scanned += 1
                if is_ignored_file(path, rules):
                    continue
                ext = Path(name).suffix.lower()
                if ext not in EXECUTABLE_OR_CONFIG_EXTENSIONS:
                    continue
                low = path.lower().replace("\\", "/")
                name_hits = sorted({term for term in strong_names if term in low})
                try:
                    modified = datetime.fromtimestamp(os.path.getmtime(path))
                except Exception:
                    modified = None
                recent = bool(modified and modified >= cutoff)
                in_ff = any(term in low for term in ff_terms)
                static = inspect_local_candidate(path, rules)
                content_hits = sorted(set(static["archive_hits"] + static["content_hits"]))

                # Do not report a suspicious filename alone unless it is executable/recent; content evidence is stronger.
                if not content_hits and not (name_hits and recent and ext in {".apk", ".dex", ".jar", ".so", ".sh", ".lua"}):
                    continue
                points = 5
                anchor = (content_hits or name_hits)[0]
                if content_hits:
                    points += 5
                if in_ff:
                    points += 3
                if recent:
                    points += 2
                findings.append(finding(
                    "archivo", "Archivo técnicamente compatible con modificación", "REVISAR",
                    "MEDIA" if points < 13 else "ALTA", "MEDIA" if not content_hits else "ALTA",
                    "La revisión interna del archivo encontró indicadores técnicos compatibles con modificación. El nombre y la ruta se mantienen fuera de la interfaz principal.",
                    source="filesystem", anchor=anchor, points=points,
                    technical={
                        "extension": ext, "reciente": recent, "ruta_free_fire": in_ff,
                        "contenido_indicadores": content_hits[:10], "nombre_indicadores": name_hits[:10],
                        "sha256": sha256_file(path), "nombre_oculto_en_interfaz": True
                    }
                ))
                if len(findings) >= 20:
                    return findings, scanned
    return findings, scanned

def parse_epoch(value):
    try:
        return datetime.fromtimestamp(int(value))
    except Exception:
        return None


def scan_replay(rules, cutoff):
    """Revisa replay con un presupuesto de tiempo estricto y consultas ADB por lotes.

    Evita ejecutar un `stat` ADB por archivo. Solo inspecciona paquetes de Free Fire
    instalados, limita carpetas/archivos y corta el módulo si supera ~25 segundos.
    """
    findings = []
    replay_names = rules["replay_names"]
    records = []
    replay_dirs = []
    started = time.monotonic()
    deadline = started + 25.0
    truncated = False

    # Solo revisar paquetes realmente instalados. Normalmente será uno.
    installed_pkgs = []
    for pkg in rules["free_fire_packages"]:
        if time.monotonic() >= deadline:
            truncated = True
            break
        if adb_shell(f"pm path {shlex.quote(pkg)} 2>/dev/null", timeout=3).strip():
            installed_pkgs.append(pkg)

    dir_expr = " -o ".join(f"-iname '*{name}*'" for name in replay_names)

    # Límite global: no más de 6 carpetas de replay entre todos los paquetes.
    for pkg in installed_pkgs:
        if len(replay_dirs) >= 6 or time.monotonic() >= deadline:
            truncated = True
            break
        for root in (f"/sdcard/Android/data/{pkg}", f"/sdcard/Android/media/{pkg}"):
            if len(replay_dirs) >= 6 or time.monotonic() >= deadline:
                truncated = True
                break
            remaining = max(1, int(deadline - time.monotonic()))
            dirs_out = adb_shell(
                f"find {shlex.quote(root)} -maxdepth 7 -type d \\( {dir_expr} \\) -print 2>/dev/null | head -6",
                timeout=min(5, remaining),
            )
            for d in (x.strip() for x in dirs_out.splitlines() if x.strip()):
                if d not in replay_dirs:
                    replay_dirs.append(d)
                if len(replay_dirs) >= 6:
                    break

    # Un solo comando ADB por carpeta. `find -exec stat` evita miles de round-trips.
    for replay_dir in replay_dirs[:6]:
        if time.monotonic() >= deadline:
            truncated = True
            break
        remaining = max(1, int(deadline - time.monotonic()))
        batch = adb_shell(
            "find " + shlex.quote(replay_dir)
            + " -maxdepth 4 -type f -exec stat -c '%X|%Y|%Z|%s' {} \\; 2>/dev/null | head -80",
            timeout=min(7, remaining),
        )
        for line in batch.splitlines():
            parts = line.strip().split("|")
            if len(parts) < 4:
                continue
            records.append({
                "atime": safe_int(parts[0]),
                "mtime": safe_int(parts[1]),
                "ctime": safe_int(parts[2]),
                "size": safe_int(parts[3]),
            })
            # Límite global adicional para que el análisis posterior sea constante.
            if len(records) >= 240:
                truncated = True
                break
        if len(records) >= 240:
            break

    elapsed = round(time.monotonic() - started, 2)
    if not records:
        return findings, {
            "replay_dirs": len(set(replay_dirs)), "replay_files": 0,
            "elapsed_seconds": elapsed, "limited": truncated,
        }

    now = datetime.now()
    recent_mtime = []
    future = []
    placed_recently_with_old_mtime = []
    large_time_gaps = []
    for r in records:
        at, mt, ct = parse_epoch(r["atime"]), parse_epoch(r["mtime"]), parse_epoch(r["ctime"])
        if mt and mt >= cutoff:
            recent_mtime.append(r)
        if mt and mt > now + timedelta(minutes=10):
            future.append(r)
        # ctime reciente + mtime claramente antiguo puede ser compatible con copia/restauración.
        if ct and mt and ct >= cutoff and mt < cutoff - timedelta(hours=2) and (ct - mt).total_seconds() > 6 * 3600:
            placed_recently_with_old_mtime.append(r)
        if mt and ct and abs((ct - mt).total_seconds()) > 7 * 86400:
            large_time_gaps.append(r)

    suspicious = bool(future or placed_recently_with_old_mtime)
    if suspicious:
        findings.append(finding(
            "replay", "Posible replay reemplazado", "REVISAR", "MEDIA", "MEDIA",
            "Los metadatos muestran una copia/restauración reciente o una fecha incoherente. Es compatible con un pasador de replay, pero no lo confirma por sí solo.",
            source="replay", anchor="replay", points=10,
            technical={
                "carpetas_replay": len(set(replay_dirs)), "archivos_replay": len(records),
                "fecha_futura": len(future), "copiado_reciente_con_fecha_antigua": len(placed_recently_with_old_mtime),
                "saltos_temporales_grandes": len(large_time_gaps), "limited": truncated,
                "elapsed_seconds": elapsed,
            }
        ))
    elif recent_mtime:
        findings.append(finding(
            "replay", "Replay reciente", "NORMAL / CONTEXTO", "BAJA", "ALTA",
            "Hay actividad reciente de replay sin una anomalía material. No se marca como pasador de replay.",
            source="replay", anchor="replay", points=0,
            technical={
                "carpetas_replay": len(set(replay_dirs)), "archivos_replay": len(records),
                "recientes": len(recent_mtime), "limited": truncated, "elapsed_seconds": elapsed,
            }
        ))

    return findings, {
        "replay_dirs": len(set(replay_dirs)), "replay_files": len(records),
        "recent": len(recent_mtime), "future": len(future),
        "placed_recently_with_old_mtime": len(placed_recently_with_old_mtime),
        "elapsed_seconds": elapsed, "limited": truncated,
    }


