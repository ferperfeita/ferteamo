def parse_ss_connections(text):
    rows = []
    for line in text.splitlines():
        low = line.lower()
        if not any(k in low for k in ("estab", "listen", "syn-sent", "udp")):
            continue
        endpoints = re.findall(r"(?:(?:\[)?([0-9a-fA-F:.]+)(?:\])?):(\d+)", line)
        if len(endpoints) < 1:
            continue
        local = endpoints[0]
        remote = endpoints[1] if len(endpoints) > 1 else ("", "0")
        rows.append({
            "raw": line[:500], "local_host": local[0], "local_port": safe_int(local[1]),
            "remote_host": remote[0], "remote_port": safe_int(remote[1]), "state": "ESTAB" if "estab" in low else "OTHER"
        })
    return rows


def is_public_ip(value):
    value = str(value or "").strip().strip("[]")
    if not value or value in {"*", "0.0.0.0", "::", "127.0.0.1", "::1"}:
        return False
    try:
        ip = ipaddress.ip_address(value.split("%", 1)[0])
        return not (ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_unspecified)
    except Exception:
        return False


