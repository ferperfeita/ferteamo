        ))
    if selinux and selinux.lower() != "enforcing":
        findings.append(finding(
            "integridad", "SELinux no está en modo Enforcing", "ENTORNO ALTERADO", "BAJA", "ALTA",
            "SELinux está menos restrictivo de lo habitual. Se conserva como contexto, no como veredicto de cheat.",
            source="system", anchor="selinux", points=2, technical={"mode": selinux}
