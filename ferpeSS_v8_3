            source="system", anchor="virtualization", points=1, technical={"signals": virtualization}
        ))
    return findings, {"developer_options": dev == "1", "adb_enabled": adb_on == "1", "selinux": selinux, "signals": altered, "virtualization": bool(virtualization)}


