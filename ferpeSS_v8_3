    if vals.get("debuggable") == "1": altered.append("debuggable_build")
    if vals.get("secure") == "0": altered.append("insecure_build")
    if mounts.strip(): altered.append("altered_mounts")

    virtualization = []
    fp = vals.get("fingerprint", "").lower()
    if vals.get("qemu") == "1" or any(x in fp for x in ("generic", "emulator", "sdk_gphone", "vbox", "genymotion")):
