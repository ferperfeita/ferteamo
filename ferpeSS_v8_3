def canonical_anchor(value):
    """Normaliza herramientas relacionadas para correlacionar fuentes sin usar tokens genéricos."""
    low = normalize(value).lower()
    if any(x in low for x in ("frida", "gum-js-loop", "gadget")):
        return "frida"
    if any(x in low for x in ("lsposed", "edxposed", "xposed", "riru")):
        return "xposed"
    if any(x in low for x in ("gameguardian", "game guardian", "androidgg")):
        return "memory_editor"
    if any(x in low for x in ("magisk", "kernelsu", "apatch", "zygisk", "shamiko", "susfs")):
        return "root"
    return low


def safe_int(value, default=0):
    try:
        return int(value)
    except Exception:
        return default


def sha256_file(path, max_mb=120):
    try:
        if os.path.getsize(path) > max_mb * 1024 * 1024:
            return None
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1024 * 1024), b""):
                h.update(chunk)
        return h.hexdigest()
    except Exception:
        return None


