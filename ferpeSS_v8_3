        ("UNIX_SOCKETS", "cat /proc/net/unix 2>/dev/null"),
        ("SELINUX_MOUNTS", "getenforce 2>/dev/null; cat /proc/mounts 2>/dev/null | grep -Ei 'overlay|magisk|ksu|apatch'"),
        ("LOGCAT", "logcat -d -v threadtime -t 3500 2>/dev/null"),
    ]
    with open(target, "w", encoding="utf-8") as f:
        f.write(f"andreznSS {VERSION} · diagnóstico solo lectura · {now_iso()}\n")
        for title, cmd in sections:
            f.write(f"\n===== {title} =====\n")
            f.write(adb_shell(cmd, timeout=35))
            f.write("\n")
    print(f"Guardado en: {target}")
    input("\nEnter para continuar...")


def menu():
    while True:
        header()
        status_line("ADB", "conectado" if has_device() else "sin conexión")
        print(f"\n{WHITE}[0]{RESET} Emparejar / conectar ADB")
        print(f"{WHITE}[1]{RESET} Iniciar análisis")
        print(f"{WHITE}[2]{RESET} Verificar integridad de reporte")
        print(f"{WHITE}[3]{RESET} Crear BugReport manual")
        print(f"{WHITE}[4]{RESET} Guardar diagnóstico técnico")
        print(f"{WHITE}[5]{RESET} Salir\n")
        choice = input("Selecciona: ").strip()
        if choice == "0": pair_device()
        elif choice == "1": run_scan()
        elif choice == "2": verify_screen()
        elif choice == "3": create_bugreport()
        elif choice == "4": save_technical_dump()
        elif choice == "5": break


def parse_args():
    p = argparse.ArgumentParser(description="andreznSS")
    p.add_argument("--nick")
    p.add_argument("--scan", action="store_true")
    return p.parse_args()


def main():
    ensure_dirs()
    args = parse_args()
    if args.scan or args.nick:
        run_scan(args.nick)
    else:
        menu()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nCancelado.")
